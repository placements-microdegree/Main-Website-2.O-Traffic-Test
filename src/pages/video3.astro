---
import LPLayout from '../layouts/LPLayout.astro';
---

<LPLayout title="3-Step Framework Video | MicroDegree" description="Watch the free MicroDegree video on the 3-step framework to switch to Cloud, DevOps & AI roles." path="/video3" noindex>
	<div class="flex flex-col items-center justify-center p-4 bg-gray-100">
		<div class="w-full max-w-5xl">
			<div class="relative w-full aspect-w-16 aspect-h-9">
				<iframe
					loading="lazy"
					title="vimeo-player"
					src="https://player.vimeo.com/video/1076877917?share=copy#t=0"
					class="w-full h-full rounded-lg shadow-lg"
					frameborder="0"
					allowfullscreen
				></iframe>
			</div>
			<div class="mt-6 mb-6 flex justify-center">
				<a
					href="https://firebasestorage.googleapis.com/v0/b/md-android-f745b.appspot.com/o/Curriculum%2FAWS%20and%20DevOps%20%2B%20AI%20Curriculm.pdf?alt=media&token=a2246e05-5db1-442b-a778-bfbedf1d23b3"
					download
					class="px-6 py-3 text-white bg-blue-600 hover:bg-blue-700 rounded-lg shadow-md text-lg font-semibold transition inline-flex items-center"
				>
					<i class="fa-solid fa-download mr-2"></i>
					Download Curriculum
				</a>
			</div>
		</div>
	</div>
</LPLayout>
