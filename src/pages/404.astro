---
// "Page not found": the site navbar and footer around a short message. Hosts such as Netlify serve this file for unknown URLs.
import LPLayout from '../layouts/LPLayout.astro';
---

<LPLayout
	title="404 – Page Not Found | MicroDegree"
	description="The page you are looking for does not exist or has moved. Head back to the MicroDegree home page."
	path="/404"
	noindex
>
	<section class="nf">
		<div class="nf-in">
			<p class="nf-code">404</p>
			<h1>Page not found</h1>
			<p class="nf-text">Sorry, we couldn't find the page you were looking for. It may have been moved or the link might be wrong.</p>
			<div class="nf-actions">
				<a class="nf-btn nf-primary" href="/">Go to Home</a>
			</div>
		</div>
	</section>
</LPLayout>

<style>
	.nf { min-height: 60vh; display: grid; place-items: center; padding: 72px 24px; text-align: center; }
	.nf-in { max-width: 560px; }
	.nf-code { margin: 0; font-size: clamp(5rem, 18vw, 9rem); font-weight: 400; line-height: 1; letter-spacing: -0.04em; color: #151595; }
	h1 { margin: 12px 0 10px; font-size: clamp(1.6rem, 4vw, 2.2rem); font-weight: 600; color: var(--ink, #12122b); }
	.nf-text { margin: 0 auto 28px; color: var(--muted, #5b5f7a); line-height: 1.6; }
	.nf-actions { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
	.nf-btn { display: inline-flex; align-items: center; justify-content: center; padding: 12px 24px; border-radius: 999px; font-weight: 600; font-size: 0.95rem; text-decoration: none; border: 2px solid transparent; transition: transform 0.15s ease, background 0.15s ease; }
	.nf-btn:hover { transform: translateY(-2px); }
	.nf-primary { background: var(--accent, #ff0055); color: #fff; border-right-color: #000; border-bottom-color: #000; }
</style>
