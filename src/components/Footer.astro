---
// Ported from the original React Footer: same content, links and layout (desktop banner + 6-column footer, stacked mobile footer).
const social = [
	{ label: 'Facebook', icon: 'fa-facebook-f', href: 'https://www.facebook.com/MicroDegree-101072281390361/?modal=admin_todo_tour', plain: true },
	{ label: 'X (Twitter)', icon: 'fa-x-twitter', href: 'https://x.com/micro_degree' },
	{ label: 'LinkedIn', icon: 'fa-linkedin-in', href: 'https://www.linkedin.com/company/microdegree/?viewAsMember=true' },
	{ label: 'YouTube', icon: 'fa-youtube', href: 'https://www.youtube.com/channel/UCu8l4v6xqQd8LfOfd0kMPsA' },
	{ label: 'Instagram', icon: 'fa-instagram', href: 'https://www.instagram.com/microdegree.work/?hl=en' },
];
const play = 'https://play.google.com/store/apps/details?id=work.microdegree.trainings&referrer=utm_source=webpage&utm_medium=footer&utm_campaign=app_launch';
const ios = 'https://apps.apple.com/us/app/microdegree/id6776628451';

const courses = [
	{ t: 'Power BI', h: '/PowerBi' },
	{ t: 'Docker & Kubernetes', h: '/dockerandkubernetes' },
	{ t: 'Java Automation Testing', h: '/java-at' },
	{ t: 'Python Automation Testing', h: 'https://microdegree.thinkific.com/courses/automation-testing-selenium' },
];
const company = [
	{ t: 'Blogs', h: 'https://www.microdegree.work/blog' },
	{ t: 'About', h: '/about' },
	{ t: 'Tech. <strong class="kn">ಹರಟೆ</strong>', h: 'https://techharate.in/' },
	{ t: 'Refund Policy', h: 'https://www.microdegree.work/refund-and-course-rescheduling-policy' },
	{ t: 'Community', h: 'https://t.me/microdegreekannada' },
];
const useful = [
	{ t: 'Jobs', h: 'https://portal.microdegree.work', hot: true },
	{ t: 'Careers', h: 'https://careers.microdegree.work', hot: true },
	{ t: 'Resources', h: 'https://resources.microdegree.work/resources?utm_source=footer', hot: true },
	{ t: 'Full Courses', h: '/YTFullCoursePage' },
	{ t: 'Refer & Earn', h: 'https://mdegree.in/web_referral', hot: true },
];
const legal = [
	{ t: 'Terms & Conditions', h: '/termsandconditions' },
	{ t: 'Refund Policy', h: '/refund-and-course-rescheduling-policy' },
	{ t: 'Legal & Privacy', h: '/Legal' },
];
---

<footer>
	{/* Desktop app banner */}
	<section class="banner">
		<img class="banner-bg" src="/img/chrome/Canva.webp" alt="MicroDegree mobile app download banner" loading="lazy" decoding="async" />
		<div class="banner-in">
			<div class="banner-copy">
				<div class="eyebrow"><i></i><i class="long"></i><p>M o b i l e A p p</p><i></i><i></i></div>
				<h2><b>Download</b><br />Our App</h2>
				<p class="blurb">Get up to date with the latest technologies and certification with IT skills. Download our app now &amp; be part of fastest growing sector of the Indian economy.</p>
				<div class="stores">
					<a href={play}><img src="/img/chrome/playstore.webp" alt="Download MicroDegree app on Google Play Store" width="261" height="78" loading="lazy" decoding="async" /></a>
					<a href={ios}><img src="/img/chrome/IOS.png" alt="Download MicroDegree app on the App Store" width="320" height="98" loading="lazy" decoding="async" /></a>
				</div>
			</div>
			<div class="phones" aria-hidden="true">
				<img class="ph-back" src="/img/chrome/P1.webp" alt="" loading="lazy" decoding="async" />
				<img class="ph-front" src="/img/chrome/P2.webp" alt="" loading="lazy" decoding="async" />
			</div>
		</div>
	</section>

	{/* Desktop main footer */}
	<section class="dsk">
		<div class="row">
			<div class="c-brand">
				<div>
					<h2>Micro<b>Degree<sup>®</sup></b></h2>
					<p class="tiny">Incubated at RIIDL, Somaiya Vidyavihar University</p>
				</div>
				<p class="small">GSTIN: 29AAJCP3260F2ZB</p>
				<p class="small">MicroDegree is an Ed-tech platform teaching coding &amp; job-ready skills in Kannada at an affordable price</p>
				<div class="social">
					{social.map((s) => (
						<a class:list={{ plain: s.plain }} href={s.href} target="_blank" rel="noopener noreferrer" aria-label={`MicroDegree on ${s.label}`}><i class={`fa-brands ${s.icon}`}></i></a>
					))}
				</div>
			</div>

			<div class="c-courses">
				<ul>
					<li class="h">Live-Recorded Courses</li>
					{courses.map((l) => <li class="lnk"><a href={l.h} target="_blank" rel="noopener noreferrer">{l.t}</a></li>)}
				</ul>
			</div>

			<div class="c-third">
				<ul>
					<li class="h">Company</li>
					{company.map((l) => <li class="lnk"><a href={l.h} target="_blank" rel="noopener noreferrer" set:html={l.t} /></li>)}
				</ul>
			</div>

			<div class="c-third">
				<ul>
					<li class="h">Useful Links</li>
					{useful.map((l) => <li class:list={['lnk', { hot: l.hot }]}><a href={l.h} target="_blank" rel="noopener noreferrer">{l.t}</a></li>)}
				</ul>
			</div>

			<div class="c-contact">
				<h3>Contact us</h3>
				<p class="ico"><i class="fa-solid fa-phone"></i> 0804-710-9999</p>
				<p class="office">Mangaluru Office:<br />K-tech Innovation Hub, 3rd Floor, Plama Building, Bejai, Mangaluru, Karnataka 575004.</p>
			</div>

			<div class="c-contact c-contact2">
				<p class="ico"><i class="fa-solid fa-envelope"></i> hello@microdegree.work</p>
				<p class="office">Bengaluru Office:<br />Sri Guruprasad Vasavi Classic 3rd Floor,10th Main Rd, 4th Block, Jayanagar, Bengaluru, Karnataka 560011.</p>
			</div>
		</div>

		<div class="legal">
			<p>Copyright © MICRODEGREE EDUCATION PRIVATE LIMITED. All Rights Reserved.</p>
			<div>
				{legal.map((l) => <a href={l.h} target="_blank" rel="noopener noreferrer">{l.t}</a>)}
			</div>
		</div>
	</section>

	{/* Mobile footer */}
	<a class="m-banner" href={play}>
		<img src="/img/chrome/Canva.webp" alt="MicroDegree mobile app download banner" loading="lazy" decoding="async" />
		<div class="m-banner-in">
			<div class="eyebrow m-eyebrow"><i></i><i class="long"></i><p>M o b i l e A p p</p><i></i><i></i></div>
			<h2>Download MicroDegree App</h2>
			<div class="m-stores">
				<span><img src="/img/chrome/playstore.webp" alt="Download MicroDegree app on Google Play" width="261" height="78" loading="lazy" /></span>
				<span><img class="ios" src="/img/chrome/IOS.png" alt="App Store" width="320" height="98" loading="lazy" /></span>
			</div>
		</div>
	</a>

	<div class="m-main">
		<div class="m-block">
			<h2 class="m-brand">Micro<b>Degree®</b></h2>
			<p class="tiny">Incubated at RIIDL, Somaiya Vidyavihar University</p>
			<p class="m-p">GSTIN: 29AAJCP3260F2ZB</p>
			<p class="m-p">MicroDegree is an Ed-tech platform teaching coding &amp; job-ready skills in Kannada at an affordable price.</p>
		</div>

		<div class="m-block">
			<h2>Live-Recorded Courses</h2>
			<p class="m-p">
				<a href="/PowerBi" target="_blank" rel="noopener noreferrer">Power BI</a> | <a href="/dockerandkubernetes" target="_blank" rel="noopener noreferrer">Docker &amp; Kubernetes</a> | <a href="/java-at" target="_blank" rel="noopener noreferrer">Java Automation Testing</a> | <a href="https://microdegree.thinkific.com/courses/automation-testing-selenium" target="_blank" rel="noopener noreferrer">Python Automation Testing</a>
			</p>
		</div>

		<div class="m-block">
			<h2>Useful Links</h2>
			<p class="m-p">
				<a href="https://www.microdegree.work/blog" target="_blank" rel="noopener noreferrer">Blogs</a> | <a class="y" href="https://careers.microdegree.work" target="_blank" rel="noopener noreferrer">Careers</a> | <a class="y" href="https://resources.microdegree.work/resources?utm_source=footer" target="_blank" rel="noopener noreferrer">Resources</a> | <a class="y" href="https://portal.microdegree.work/" target="_blank" rel="noopener noreferrer">Jobs</a> | <a href="/YTFullCoursePage" target="_blank" rel="noopener noreferrer">Full Courses</a> | <a class="y" href="https://mdegree.in/web_referral" target="_blank" rel="noopener noreferrer">Refer &amp; Earn</a> | <a href="https://t.me/microdegreekannada" target="_blank" rel="noopener noreferrer">Community</a>
			</p>
		</div>

		<div class="m-block">
			<h2>Company</h2>
			<p class="m-p">
				<a href="/refund-and-course-rescheduling-policy" target="_blank" rel="noopener noreferrer">Refund Policy</a> | <a href="/termsandconditions" target="_blank" rel="noopener noreferrer">Terms &amp; Conditions</a> | <a href="/Legal" target="_blank" rel="noopener noreferrer">Legal &amp; Privacy</a>
			</p>
		</div>

		<div class="m-contact">
			<h3>Contact us</h3>
			<p class="m-p">MicroDegree Education Private Limited (Formerly Pillpouch Healthtech Private Limited)<br />Mangaluru Office:<br />K-tech Innovation Hub, 3rd Floor, Plama Building, Bejai, Mangaluru, Karnataka 575004.<br /><br />Bengaluru Office:<br />Sri Guruprasad Vasavi Classic 3rd Floor,10th Main Rd, 4th Block, Jayanagar, Bengaluru, Karnataka 560011.</p>
			<div class="social m-social">
				{social.map((s) => (
					<a class:list={{ plain: s.plain }} href={s.href} target="_blank" rel="noopener noreferrer" aria-label={`MicroDegree on ${s.label}`}><i class={`fa-brands ${s.icon}`}></i></a>
				))}
			</div>
			<p class="m-ico"><i class="fa-solid fa-phone"></i> 0804-710-9999</p>
			<p class="m-ico"><i class="fa-solid fa-envelope"></i> hello@microdegree.work</p>
		</div>
	</div>

	<div class="m-legal">
		{legal.map((l) => <a href={l.h} target="_blank" rel="noopener noreferrer">{l.t}</a>)}
	</div>
	<div class="m-copy"><p>Copyright © MICRODEGREE EDUCATION PRIVATE LIMITED. <br />All rights reserved.</p></div>
</footer>

<style is:global>
	.kn { font-family: 'Anek Kannada', sans-serif; font-weight: 700; }
</style>

<style>
	footer { text-align: left; }

	/* ---------- shared bits ---------- */
	.eyebrow { display: flex; align-items: center; gap: 12px; color: #fff; }
	.eyebrow i { display: block; width: 6.4px; height: 6.4px; background: #fff; border-radius: 12px; }
	.eyebrow i.long { width: 4.8px; }
	.eyebrow p { text-transform: uppercase; letter-spacing: .1em; font-weight: 200; font-size: .75rem; }
	.social { display: flex; gap: 12px; padding: 8px 0; }
	.social a { display: grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; background: #fff; color: #364045; font-size: .875rem; transition: background .3s, transform .3s; }
	.social a.plain { width: auto; height: auto; background: none; color: #fff; font-size: 1.5rem; border-radius: 0; }
	.social a:hover { background: #1da0f0; }
	.social a.plain:hover { background: none; color: #1da0f0; }
	@media (min-width: 768px) { .social a:hover { transform: translateY(-4px); } }

	/* ---------- Desktop app banner (md+) ---------- */
	.banner { display: none; position: relative; width: 100%; overflow: hidden; }
	.banner-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
	.banner-in { position: relative; z-index: 20; display: flex; align-items: center; height: 300px; }
	.banner-copy { flex-basis: 50%; padding: 40px; display: grid; gap: 8px; color: #fff; }
	.banner-copy h2 { font-size: 3rem; line-height: 1; margin: 28px 0 0; font-weight: 400; }
	.banner-copy h2 b { font-weight: 600; }
	.blurb { font-size: .875rem; margin: 28px 0; width: 100%; line-height: 1.5; }
	.stores { display: flex; align-items: center; gap: 16px; }
	.stores img { width: 9rem; height: auto; object-fit: contain; box-shadow: 0 20px 25px -5px rgb(0 0 0 / .1), 0 8px 10px -6px rgb(0 0 0 / .1); transition: transform .3s; }
	.stores a:hover img { transform: translateY(-4px); }
	.phones { position: relative; flex-basis: 50%; align-self: stretch; overflow: hidden; }
	.phones img { position: absolute; object-fit: contain; height: auto; }
	.ph-back { width: 140px; right: 2rem; bottom: -10px; transform: rotate(10deg); opacity: .95; z-index: 10; }
	.ph-front { width: 140px; right: 5rem; bottom: 0; z-index: 20; }
	@media (min-width: 768px) { .banner { display: block; } }
	@media (min-width: 1024px) {
		.banner-in { height: 360px; }
		.banner-copy { padding: 40px 64px; }
		.blurb { width: 320px; }
		.ph-back { width: 150px; right: 7rem; }
		.ph-front { width: 170px; right: 12rem; }
	}
	@media (min-width: 1280px) {
		.banner-in { height: 430px; }
		.banner-copy { padding: 40px 144px; }
		.blurb { width: 400px; }
		.ph-back { width: 170px; right: 9rem; }
		.ph-front { width: 200px; right: 16rem; }
	}
	@media (min-width: 1536px) {
		.banner-in { height: 580px; }
		.banner-copy { padding: 56px 176px; }
		.banner-copy h2 { font-size: 4.5rem; }
		.blurb { width: 450px; font-size: 1.125rem; }
		.stores { gap: 24px; }
		.stores img { width: 14rem; }
		.eyebrow p { font-size: .9rem; }
		.ph-back { width: 220px; }
		.ph-front { width: 260px; }
	}

	/* ---------- Desktop main footer (sm+) ---------- */
	.dsk { display: none; background: #364045; color: #fff; padding: 24px 80px 0; }
	@media (min-width: 640px) { .dsk { display: block; } }
	.row { display: flex; align-items: flex-start; gap: 24px; padding: 16px 0; border-bottom: 1.6px solid #4b5563; }
	.c-brand { flex: 0 1 25%; display: grid; gap: 16px; }
	.c-brand h2 { font-size: 1.5rem; font-weight: 400; line-height: .75rem; width: fit-content; }
	.c-brand h2 b { font-weight: 500; font-size: 1.875rem; }
	.c-brand sup { font-size: 1.25rem; }
	.c-brand .tiny { margin-top: 14px; }
	.tiny { font-size: 10px; line-height: 1.25rem; color: #9ca3af; font-weight: 300; width: 12rem; }
	.small { font-size: .75rem; line-height: 1.25rem; color: #9ca3af; font-weight: 300; width: 12rem; }
	.c-courses { flex: 0 1 50%; }
	.c-third { flex: 0 1 33.333%; }
	.row ul { display: grid; gap: 8px; font-weight: 300; list-style: none; padding: 0; margin: 0; }
	.row .h { font-weight: 500; letter-spacing: .025em; color: #e5e7eb; }
	.lnk { font-size: .875rem; color: #9ca3af; transition: transform .3s; }
	.lnk.hot { color: #facc15; }
	@media (min-width: 768px) { .lnk:hover { transform: translateX(4px); } }
	.c-contact { flex: 0 1 25%; display: grid; gap: 12px; font-size: .75rem; font-weight: 300; color: #9ca3af; }
	.c-contact h3 { color: #d1d5db; font-size: 1.125rem; font-weight: 500; letter-spacing: .025em; margin: 0; }
	.c-contact2 { padding: 28px 0 0 16px; }
	.ico { display: flex; align-items: center; gap: 8px; }
	.ico i { font-size: .75rem; }
	.office { width: 14rem; font-size: 1rem; line-height: 1.5; }
	.c-contact2 .office { width: auto; }
	.legal { display: flex; align-items: center; justify-content: space-between; padding: 8px 0; font-size: .75rem; font-weight: 300; color: #9ca3af; }
	.legal > div { display: flex; align-items: center; gap: 24px; }
	.legal a:hover { color: #fff; }
	@media (min-width: 1536px) {
		.c-brand h2 { font-size: 1.875rem; }
		.tiny { width: 14rem; font-size: .75rem; }
		.small { width: 14rem; font-size: .875rem; }
		.row .h { font-size: 1rem; }
		.row .c-courses .h { font-size: 1.125rem; }
		.lnk { font-size: 1rem; }
		.c-contact { font-size: 1.125rem; }
	}

	/* ---------- Mobile footer (< sm) ---------- */
	.m-banner { display: block; position: relative; width: 100%; height: 24rem; overflow: hidden; }
	.m-banner > img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
	.m-banner-in { position: absolute; inset: 0; z-index: 20; display: flex; flex-direction: column; justify-content: center; gap: 32px; }
	.m-eyebrow { padding: 0 40px; }
	.m-banner h2 { padding: 0 40px; font-size: 1.875rem; font-weight: 600; color: #fff; line-height: 1.25; margin: 0; }
	.m-stores { display: flex; justify-content: space-around; align-items: center; gap: 16px; padding: 0 24px; }
	.m-stores img { width: 9rem; height: auto; object-fit: contain; box-shadow: 0 20px 25px -5px rgb(0 0 0 / .1); }
	.m-main { background: #364045; padding: 40px; display: flex; flex-direction: column; gap: 24px; color: #fff; }
	.m-block { display: grid; gap: 8px; font-size: .875rem; font-weight: 300; }
	.m-block h2 { font-size: 1.125rem; font-weight: 500; margin: 0; }
	.m-block .tiny { width: auto; color: inherit; font-size: .75rem; margin-bottom: 8px; }
	.m-block h2.m-brand { font-size: 1.875rem; font-weight: 400; }
	.m-brand b { font-weight: 500; }
	.m-p { font-size: .875rem; font-weight: 300; line-height: 1.5; margin: 0; }
	.y { color: #facc15; }
	.m-contact { display: grid; justify-items: center; gap: 12px; font-size: .875rem; font-weight: 300; color: #e5e7eb; }
	.m-contact h3 { justify-self: start; font-size: 1.5rem; font-weight: 500; margin: 0; }
	.m-contact .m-p { text-align: left; }
	.m-social { padding: 8px 0; }
	.m-ico { display: flex; align-items: center; gap: 8px; font-size: .75rem; margin: 0; }
	.m-legal { display: flex; justify-content: center; gap: 56px; padding: 12px; background: #364045; border-top: .5px solid #e5e7eb; font-size: .6rem; color: #e5e7eb; }
	.m-copy { display: flex; justify-content: center; padding-bottom: 12px; background: #364045; color: #e5e7eb; font-size: .7rem; text-align: center; }
	@media (min-width: 640px) { .m-banner, .m-main, .m-legal, .m-copy { display: none; } }
</style>
