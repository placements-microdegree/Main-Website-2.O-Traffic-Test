---
import DemoForm from '../DemoForm.astro';
const gif1 = '/lp/genaidemo/genai-hero.mp4';
---

<Fragment>

    <div class="py-16 px-4 bg-neutral-50">

      <div class="max-w-7xl mx-auto">

        {/* HERO TEXT */}
        <div class="text-center max-w-6xl mx-auto mb-7">

          <h1 class="text-3xl text-[#151595] sm:text-4xl lg:text-5xl font-semibold leading-tight tracking-tight mb-5">
            Still stuck in the roles getting replaced by AI?
          </h1>

          <h2 class="text-lg sm:text-xl lg:text-2xl text-neutral-600 font-medium mb-8">
            Master Gen AI & Future-Proof Your Career for High-Paying Roles
          </h2>

          <p class="inline-flex items-center gap-2 text-sm sm:text-base font-semibold text-neutral-900 border border-neutral-300 rounded-full px-6 py-2.5 bg-white shadow-sm">
            Take a Free Demo Now 👇🏼
          </p>

        </div>

        {/* SINGLE VIDEO CARD */}
        <div class="max-w-xl mx-auto">

          <div class="bg-white rounded-2xl border border-neutral-200 shadow-[0_20px_50px_-15px_rgba(0,0,0,0.12)] hover:shadow-[0_25px_60px_-15px_rgba(0,0,0,0.18)] transition-shadow duration-300 overflow-hidden">

            <div class="relative aspect-video overflow-hidden">

              <video
                src={gif1}
                aria-label="Generative AI career demo covering AI tools and AI agents"
                class="w-full h-full object-cover"
                autoplay
                loop
                muted
                playsinline
              />

              <div class="absolute inset-0 bg-gradient-to-t from-black/50 via-black/10 to-transparent"></div>

              <div class="absolute top-4 left-4 bg-neutral-900 text-white text-xs tracking-wide uppercase px-3 py-1 rounded-full shadow">
                Free Demo
              </div>

            </div>

            <div class="p-8 text-center">

              <h3 class="text-lg sm:text-xl font-semibold text-neutral-900 mb-6 leading-snug">
                AI for IT Professionals: Where Do I Start in 2026
              </h3>

              <button type="button" data-open-modal="modal-form1" class="bg-blue-500 text-white px-8 py-3 rounded-full font-semibold tracking-wide shadow-md hover:shadow-lg hover:bg-blue-600 transition">
                Watch Free Demo →
              </button>

            </div>

          </div>

        </div>

      </div>

      <dialog id="modal-form1" class="demo-modal">
      <div class="relative w-full">
        <button type="button" data-close-modal aria-label="Close" class="absolute -top-3 -right-3 z-10 bg-white border border-neutral-200 rounded-full w-9 h-9 shadow-md flex items-center justify-center text-neutral-500 hover:text-neutral-900 transition">✕</button>
        <DemoForm table="demo_genai" redirect="/demovideo3" heading="AI for IT Professionals: Where Do I Start in 2026" />
      </div>
    </dialog>

    </div>
    </Fragment>

<script>
  // Open/close the demo-form dialogs (native <dialog>: focus trap + Escape for free).
  document.querySelectorAll<HTMLElement>('[data-open-modal]').forEach((btn) => {
    btn.addEventListener('click', () => {
      (document.getElementById(btn.dataset.openModal!) as HTMLDialogElement | null)?.showModal();
    });
  });
  document.querySelectorAll<HTMLDialogElement>('dialog.demo-modal').forEach((dlg) => {
    dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
    dlg.querySelector('[data-close-modal]')?.addEventListener('click', () => dlg.close());
  });
</script>

<style is:global>
  dialog.demo-modal { padding: 16px; background: transparent; border: 0; max-width: 28rem; width: 100%; overflow: visible; }
  dialog.demo-modal::backdrop { background: rgba(23, 23, 23, .6); backdrop-filter: blur(6px); }
  body:has(dialog.demo-modal[open]) { overflow: hidden; }
</style>
