---
const iconStyle = "w-5 h-5 flex-shrink-0";
const comparisonData = [
  {
    feature: "Language advantage",
    icon: `<svg class="${iconStyle} text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" > <circle cx="12" cy="12" r="9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /> </svg>`,
    micro: "Learn 10x faster in Kannada",
    competitor: "Mostly English only delivery",
  },

  {
    feature: "Batch flexibility",
    icon: `<svg class="${iconStyle} text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" > <rect x="4" y="4" width="16" height="16" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /> </svg>`,
    micro: "Switch any batches within a year",
    competitor: "Fixed batches, limited flexibility",
  },

  {
    feature: "Trainer quality",
    icon: `<svg class="${iconStyle} text-violet-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" > <polygon points="12,3 22,9 12,15 2,9" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /> </svg>`,
    micro: "Active IT professionals & industry experts",
    competitor: "Professors with limited real world exposure",
  },

  {
    feature: "Course pricing",
    icon: `<svg class="${iconStyle} text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" > <path d="M12 2v20M5 7h14M5 17h14" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /> </svg>`,
    micro: "Affordable & ROI-driven pricing",
    competitor: "Often charge ₹1 - 3+ lakhs",
  },

  {
    feature: "Target audience",
    icon: `<svg class="${iconStyle} text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" > <circle cx="8" cy="10" r="3" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /> </svg>`,
    micro: "Designed for mid & senior IT professionals",
    competitor: "Cater to everyone → mixed cohort quality",
  },

  {
    feature: "Live interaction",
    icon: `<svg class="${iconStyle} text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" > <path d="M12 1v11" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /> </svg>`,
    micro:
      "Learners can unmute & interact anytime with trainers",
    competitor:
      "Muted, one sided webinar style sessions",
  },

  {
    feature: "Curriculum structure",
    icon: `<svg class="${iconStyle} text-teal-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" > <rect x="6" y="4" width="12" height="16" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /> </svg>`,
    micro:
      "Comprehensive program covering multiple skills & career transition",
    competitor:
      "Standalone courses with fragmented learning",
  },

  {
    feature: "Learning approach",
    icon: `<svg class="${iconStyle} text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" > <rect x="6" y="6" width="12" height="12" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /> </svg>`,
    micro:
      "Hands-on, practical, real world projects",
    competitor:
      "Theory heavy, certification focused",
  },

  {
    feature: "Career transition focus",
    icon: `<svg class="${iconStyle} text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" > <path d="M5 13l4 4L19 7" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /> </svg>`,
    micro:
      "Structured pathway to Cloud / DevOps / GenAI roles",
    competitor:
      "Skill learning without career mapping",
  },

  {
    feature: "Community advantage",
    icon: `<svg class="${iconStyle} text-cyan-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" > <circle cx="12" cy="12" r="6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /> </svg>`,
    micro:
      "Strong Kannadiga IT community & peer learning",
    competitor:
      "Limited localized community support",
  },
];
const visibleData = comparisonData;
---

<section class="py-12 px-4">
      <div class="max-w-6xl mx-auto">

        {/* Heading */}
        <h2 class="text-3xl md:text-4xl font-semibold text-center mb-10 leading-tight tracking-tight">
          MicroDegree vs Competition — Feature Comparison
        </h2>

        {/* Mobile swipe text */}
        <div class="md:hidden text-center text-sm text-gray-500 mb-4">
          ← Swipe horizontally →
        </div>

        {/* White rounded card only for mobile */}
        <div class="bg-white md:bg-transparent rounded-3xl shadow-[0_8px_30px_rgba(0,0,0,0.06)] md:shadow-none p-4 md:p-0">

          {/* Scroll container */}
          <div class="overflow-x-auto scrollbar-hide rounded-xl">

            {/* Force width on mobile */}
            <div class="min-w-[800px]">

              {/* Header */}
              <div class="grid grid-cols-3 font-bold text-xl border-b border-gray-300 pb-5">
                <div>Feature</div>
                <div>MicroDegree</div>
                <div>Typical Competitors</div>
              </div>

              {/* Rows */}
              {visibleData.map((item, index) => (
                <div
                  class:list={["grid grid-cols-3 gap-8 border-b border-gray-200 py-8 items-start", index >= 5 && "hidden"]}
                  data-extra={index >= 5 ? "" : undefined}
                >
                  {/* Feature */}
                  <div class="flex items-center gap-3 font-semibold text-lg">
                    <Fragment set:html={item.icon} />
                    <span>{item.feature}</span>
                  </div>

                  {/* MicroDegree */}
                  <div class="text-base text-left font-medium text-gray-800 leading-relaxed">
                    {item.micro}
                  </div>

                  {/* Competitor */}
                  <div class="text-base text-left text-gray-600 leading-relaxed">
                    {item.competitor}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>

        {/* Show More / Less */}
        {comparisonData.length > 5 && (
          <div class="flex justify-center mt-8">
            <button type="button" data-compare-toggle class="font-semibold hover:underline transition-colors">Show More ↓</button>
          </div>
        )}
      </div>
    </section>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-compare-toggle]').forEach((btn) => {
    const section = btn.closest('section')!;
    btn.addEventListener('click', () => {
      const open = btn.dataset.open !== 'true';
      btn.dataset.open = String(open);
      section.querySelectorAll('[data-extra]').forEach((el) => el.classList.toggle('hidden', !open));
      btn.textContent = open ? 'Show Less ↑' : 'Show More ↓';
    });
  });
</script>
