];
---

<section class="w-full py-12 px-6 sm:px-10">
  <div class="max-w-6xl mx-auto">
    <div class="flex flex-col sm:flex-row items-center sm:justify-between py-5">
      <h2 class="text-3xl sm:text-4xl font-semibold text-gray-900 text-center sm:text-left tracking-tight">Course Curriculum</h2>
      <a href="#" data-tally="mV2RpN" class="hidden sm:flex items-center justify-center gap-2 px-6 py-3 bg-blue-600 hover:bg-black text-white font-semibold rounded-lg shadow-sm hover:shadow-lg text-sm sm:text-base transition-all duration-200 hover:-translate-y-0.5 active:translate-y-0">
        <Icon name="FaDownload" class="text-white text-sm" />
        Download Complete Curriculum
      </a>
    </div>

    <div class="space-y-3">
      {curriculumData.map((item) => (
        <details class="lp-acc border rounded-xl shadow-sm hover:shadow-md transition-shadow duration-300">
          <summary class="w-full flex justify-between items-center p-4 cursor-pointer text-left">
            <div class="flex items-center space-x-3">
              <span class="shrink-0 h-2 w-2 rounded-full bg-blue-600"></span>
              <h3 class="font-medium text-gray-800">{item.title}</h3>
            </div>
            <Icon name="FiChevronDown" class="lp-acc-chevron text-gray-500" />
          </summary>
          <div class="px-6 pb-4 text-base text-gray-600 text-left">
            <ul class="list-disc pl-6 space-y-1">
              {item.desc.map((point) => <li>{point}</li>)}
            </ul>
          </div>
        </details>
      ))}
    </div>

    <div class="font-semibold text-md sm:text-xl text-center mt-5 mb-5">Download Complete Curriculum for more details.</div>

    <div class="flex justify-center mt-6">
      <a href="#" data-tally="mV2RpN" class="flex items-center justify-center gap-2 px-8 py-3 bg-blue-600 hover:bg-black text-white font-semibold rounded-lg shadow-sm hover:shadow-lg text-sm sm:text-base transition-all duration-200 hover:-translate-y-0.5 active:translate-y-0">
        <Icon name="FaDownload" class="text-white text-sm" />
        Download Complete Curriculum
      </a>
    </div>
  </div>
</section>

<style is:global>
  .lp-acc summary { list-style: none; }
  .lp-acc summary::-webkit-details-marker { display: none; }
  .lp-acc[open] .lp-acc-chevron { transform: rotate(180deg); }
  .lp-acc-chevron { transition: transform .2s; flex: none; }
</style>
