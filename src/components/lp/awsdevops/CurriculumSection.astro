    "Monitoring using Prometheus & Grafana",
    "Provisioning using Terraform",
    "AI on DevOps"
  ]
},
  {
  title: "Azure - Solutions Architect Associate Expert",
  preview: false,
  desc: [
    "Cloud Concepts",
    "Core Azure Services",
    "Security, Privacy, Compliance, and Trust",
    "Azure Pricing and Support",
    "Manage Azure Identities and Governance",
    "Implement & Manage Storage",
    "Deploy and Manage Azure Compute Resources",
    "Configure and Manage Virtual Networking",
    "Monitor and Backup Azure Resources"
  ]
},
{
  title: "DevSecOps",
  preview: false,
  desc: [
    "SAST",
    "DAST",
    "SCA",
    "Git",
    "Penetration testing",
    "Vulnerability assessment",
    "Key security principles",
    "Confidentiality, Integrity, and Availability (CIA Triad)",
    "OWASP & Security Standards and many more"
  ]
},
{
  title: "GenAI in Cloud & DevOps",
  preview: false,
  desc: [
    "Foundations of Generative AI & No-Code Tools",
    "AI for Cloud & Infrastructure",
    "AI for DevOps & Automation",
    "Advanced AI Integration & Programming"
  ]
},
{
  title: "Certified Kubernetes Administrator (CKA/CKAD)",
  preview: false,
  desc: [
    "Kubernetes Deep Architecture & Control Plane",
    "Kubernetes Installation with kubeadm",
    "Managing Static Pods & Component Configurations",
    "Pod Design (CKAD Focus)",
    "Labels, Selectors & Annotations",
    "Deployments, ReplicaSets, Rollouts",
