      "Identity Access Management",
      "ELB(Elastic Load Balancing)",
      "Logging & Monitoring Tools",
      "S3(Simple Storage Service)",
      "Databases on AWS",
      "Serverless Architectures",
      "AI in AWS"
    ]
  },
{
  title: "DevOps",
  preview: false,
  desc: [
    "DevOps Basics",
    "GIT",
    "Maven",
    "Jenkins",
    "Ansible",
