---
const ACP = '/lp/awsdevops/cloud/acp.webp';
const ASA = '/lp/awsdevops/cloud/asa.webp';
const ASC = '/lp/awsdevops/cloud/asc.webp';
const AZA = '/lp/awsdevops/cloud/aza.webp';
const AZF = '/lp/awsdevops/cloud/azf.webp';
const AZSA = '/lp/awsdevops/cloud/azsa.webp';
const CKA = '/lp/awsdevops/cloud/cka.webp';
const projects = [
    { name: "AWS Solutions Architect", img: ASC },
    { name: "AWS Cloud Practitioner", img: ACP },
    { name: "AWS SysOps Administrator", img: ASA },
    { name: "Azure Associate", img: AZA },
    { name: "Azure Solutions Architect", img: AZSA },
    { name: "Azure Fundamentals", img: AZF },
    { name: "Certified Kubernetes Administrator", img: CKA },
  ];
---

<section class="mx-auto mt-10 mb-10 max-w-6xl text-center p-6">
      {/* Header */}
      <div class="w-full flex flex-col items-center text-center space-y-3 2xl:space-y-5 mb-10">
        <h2 class="text-3xl sm:text-4xl text-center font-semibold text-gray-900 tracking-tight">
          Crack Multiple Global Certifications
        </h2>
      </div>

      {/* First row: 4 items */}
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 mb-6">
        {projects.slice(0, 4).map((project, idx) => (
          <div
           
            class="flex flex-col items-center rounded-2xl border border-black border-opacity-10 p-2 text-black transition-all duration-300 hover:border-opacity-0 hover:shadow-lg hover:-translate-y-1"
          >
            <img loading="lazy" decoding="async"
              class="w-28 h-28 sm:w-36 sm:h-36 lg:w-32 lg:h-32 object-contain"
              src={project.img}
              alt={`${project.name} certification badge`}
            />
            <div class="mt-2 text-center font-semibold text-black">
              {project.name}
            </div>
          </div>
        ))}
      </div>

      {/* Second row: 3 items centered */}
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 justify-center max-w-4xl mx-auto">
        {projects.slice(4, 7).map((project, idx) => (
          <div
           
            class="flex flex-col items-center rounded-2xl border border-black border-opacity-10 p-2 text-black transition-all duration-300 hover:border-opacity-0 hover:shadow-lg hover:-translate-y-1"
          >
            <img loading="lazy" decoding="async"
              class="w-28 h-28 sm:w-36 sm:h-36 lg:w-32 lg:h-32 object-contain"
              src={project.img}
              alt={project.name}
            />
            <div class="mt-2 text-center font-semibold text-black">
              {project.name}
            </div>
          </div>
        ))}
      </div>
    </section>
