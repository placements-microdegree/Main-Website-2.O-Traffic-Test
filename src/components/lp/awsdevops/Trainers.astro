---
const mentors = [
  {
    name: "Manoj Kumar",
    title: "Senior DevOps Engineer | FAANG Company",
    description: `With 7+ years of experience, Manoj currently works as a Senior DevOps Engineer at a leading FAANG company. He brings deep expertise in automation, CI/CD pipelines, and Cloud infrastructure, helping learners understand real-world DevOps workflows.`,
  },
  {
    name: "Likith",
    title: "Senior DevOps Engineer | FAANG Company",
    description: `Likith has over 7 years of hands-on experience as a DevOps Engineer in a top FAANG organization. He specializes in Cloud automation, containerization, and deployment pipelines, guiding learners with practical, industry-level insights.`,
  },
  {
    name: "Kumar",
    title: "Senior Cloud Engineer | FAANG Company",
    description: `With 8+ years of Cloud industry experience, Kumar works as a Senior Cloud Engineer in a FAANG company. He focuses on scalable Cloud architecture and modern infrastructure design, mentoring professionals to excel in Cloud and DevOps roles.`,
  },
  {
    name: "Gaurav Kamath",
    title: "Co-Founder | Tech Education Expert | Ex-Infosys, Accenture, Tracxn",
    description: `With 10+ years of industry experience, Gaurav has worked with leading IT firms like Infosys and Accenture. An engineer from Nitte, he now focuses on building practical Cloud and DevOps learning programs for modern tech careers.`,
  },
  {
    name: "Rakesh Kothari",
    title: "Co-Founder | Cloud & Automation Mentor | Ex-TCS, Bank of America",
    description: `Rakesh brings 15+ years of IT expertise across TCS and Bank of America. An engineer from BMS College, he specializes in Cloud, Automation, and AI-driven solutions that help professionals upskill faster.`,
  },
  {
    name: "Manikanta Nair",
    title: "Co-Founder | AI & Full Stack Mentor | Ex-Industry Professional",
    description: `With 7+ years of experience, Manikanta has developed scalable tech solutions and mentored learners in AI and Cloud technologies. An engineer from PACE, he focuses on simplifying next-gen tech concepts through practical, hands-on learning.`,
  },
];
const getInitials = (name) =>
    name
      .split(" ")
      .map((n) => n[0])
      .join("")
      .toUpperCase();
---

<div class="w-full py-12 px-6 sm:px-10 mb-10">
      <div class="max-w-6xl mx-auto">
        {/* Title */}
        <h2 class="text-3xl sm:text-4xl font-semibold text-gray-900 text-center mb-12 tracking-tight">
          Meet Our Trainers & Experts
        </h2>

        {/* Mentor Cards */}
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {mentors.map((mentor, idx) => (
            <div
             
              class="relative bg-white rounded-2xl shadow-md hover:shadow-xl hover:-translate-y-1 transition-all duration-300 p-6 text-center flex flex-col items-center"
            >
              {/* Circle with initials instead of image
              <div className="mb-5">
                <div className="w-14 h-14 rounded-full bg-blue-600 flex items-center justify-center text-white text-xl font-semibold shadow-lg hover:scale-105 transition-transform duration-300">
                  {getInitials(mentor.name)}
                </div>
              </div> */}

              {/* Name + Title */}
<h3 class="text-2xl sm:text-xl font-semibold text-gray-900 relative inline-block after:content-['✦'] after:text-yellow-500 after:ml-2 after:text-xl">
  {mentor.name}
</h3>
              <p class="text-sm text-gray-500 mb-4">{mentor.title}</p>

              {/* Divider */}
              <div class="w-20 border-t-2 border-blue-600 mb-4"></div>

              {/* Description (Justified Text) */}
              <div class="text-base text-gray-600 leading-relaxed space-y-3 text-left">
                {mentor.description.split("\n").map((para, i) => (
                  <p>{para.trim()}</p>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
