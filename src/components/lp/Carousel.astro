---
// Dependency-free replacement for react-slick: CSS scroll-snap track + arrows, dots and optional autoplay.
// Each direct child of the slot is one slide.
interface Props {
	show?: number;
	showTablet?: number;
	showMobile?: number;
	/** Autoplay delay in ms; omit to disable. */
	autoplay?: number;
	dots?: boolean;
	arrows?: boolean;
	/** Size the track to the slides currently in view (and equalise those) instead of the tallest slide overall. */
	fit?: boolean;
	/** Endless loop: the track wraps around seamlessly instead of rewinding at the end. */
	loop?: boolean;
	class?: string;
}
const { show = 1, showTablet = show, showMobile = showTablet, autoplay, dots = true, arrows = true, fit = false, loop = false, class: cls = '' } = Astro.props;
---

<div
	class:list={['lpc', cls]}
	data-lpc
	data-autoplay={autoplay}
	data-fit={fit ? '' : undefined}
	data-loop={loop ? Math.max(show, showTablet, showMobile) : undefined}
	style={`--n-d:${show};--n-t:${showTablet};--n-m:${showMobile}`}
>
	<div class="lpc-track" tabindex="0"><slot /></div>
	{arrows && (
		<>
			<button type="button" class="lpc-arrow lpc-prev" aria-label="Previous slide">&#10094;</button>
			<button type="button" class="lpc-arrow lpc-next" aria-label="Next slide">&#10095;</button>
		</>
	)}
	{dots && <div class="lpc-dots" data-dots></div>}
</div>

<style is:global>
	.lpc { position: relative; --n: var(--n-d, 1); } /* inline style sets --n-d only, so the media rules below can still override --n */
	.lpc-track { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; scroll-behavior: smooth; }
	.lpc-track::-webkit-scrollbar { display: none; }
	.lpc[data-fit] .lpc-track { align-items: flex-start; overflow-y: hidden; transition: height .25s ease; }
	.lpc-track > * { flex: 0 0 calc(100% / var(--n)); scroll-snap-align: start; min-width: 0; }
	@media (max-width: 1024px) { .lpc { --n: var(--n-t); } }
	@media (max-width: 768px) { .lpc { --n: var(--n-m); } }
	.lpc-arrow { position: absolute; top: 50%; transform: translateY(-50%); z-index: 2; width: 36px; height: 36px; border: 0; border-radius: 50%; background: rgba(255, 255, 255, .92); box-shadow: 0 2px 10px rgba(0, 0, 0, .18); color: #111; font-size: 16px; cursor: pointer; display: grid; place-items: center; }
	.lpc-arrow:hover { background: #fff; }
	.lpc-prev { left: -14px; }
	.lpc-next { right: -14px; }
	@media (max-width: 600px) { .lpc-prev { left: 4px; } .lpc-next { right: 4px; } }
	.lpc-dots { display: flex; justify-content: center; gap: 8px; margin-top: 18px; }
	.lpc-dots button { width: 9px; height: 9px; padding: 0; border: 0; border-radius: 50%; background: #111; opacity: .25; cursor: pointer; }
	.lpc-dots button[aria-current='true'] { opacity: 1; }
</style>

<script>
	document.querySelectorAll<HTMLElement>('[data-lpc]').forEach((root) => {
		const track = root.querySelector<HTMLElement>('.lpc-track')!;
		const dotsEl = root.querySelector<HTMLElement>('[data-dots]');
		const loopN = Number(root.dataset.loop) || 0;
		const originals = Array.from(track.children) as HTMLElement[];
		const total = originals.length;
		if (loopN && total > 1) {
			const c = Math.min(loopN, total);
			const clone = (el: HTMLElement) => { const k = el.cloneNode(true) as HTMLElement; k.setAttribute('aria-hidden', 'true'); k.querySelectorAll('button, a').forEach((x) => x.setAttribute('tabindex', '-1')); return k; };
			track.prepend(...originals.slice(-c).map(clone));
			track.append(...originals.slice(0, c).map(clone));
			root.dataset.loopPad = String(c);
		}
		const pad = Number(root.dataset.loopPad) || 0;
		const slides = () => Array.from(track.children) as HTMLElement[];
		const step = () => (slides()[1]?.offsetLeft ?? track.clientWidth) - (slides()[0]?.offsetLeft ?? 0) || track.clientWidth;
		const raw = () => Math.round(track.scrollLeft / step());
		const pages = () => pad ? total : Math.max(1, Math.round((track.scrollWidth - track.clientWidth) / step()) + 1);
		const current = () => pad ? (((raw() - pad) % total) + total) % total : Math.min(pages() - 1, Math.round(track.scrollLeft / step()));
		const go = (i: number) => track.scrollTo({ left: (pad ? i + pad : (i + pages()) % pages()) * step() });
		const next = (d: number) => (pad ? track.scrollTo({ left: (raw() + d) * step() }) : go(current() + d));
		if (pad) {
			const jump = (r: number) => {
				track.style.scrollBehavior = 'auto';
				track.style.scrollSnapType = 'none';
				track.scrollLeft = r * step();
				void track.offsetWidth;
				track.style.scrollBehavior = '';
				track.style.scrollSnapType = '';
			};
			const settle = () => { const r = raw(); if (r < pad) jump(r + total); else if (r >= pad + total) jump(r - total); };
			let st: number | undefined;
			track.addEventListener('scroll', () => { clearTimeout(st); st = window.setTimeout(settle, 140); }, { passive: true });
			window.addEventListener('resize', () => jump(current() + pad));
			jump(pad);
		}

		const renderDots = () => {
			if (!dotsEl) return;
			const n = pages();
			if (dotsEl.childElementCount !== n) {
				dotsEl.replaceChildren(...Array.from({ length: n }, (_, i) => {
					const b = document.createElement('button');
					b.type = 'button';
					b.setAttribute('aria-label', `Go to slide ${i + 1}`);
					b.addEventListener('click', () => go(i));
					return b;
				}));
			}
			Array.from(dotsEl.children).forEach((b, i) => b.setAttribute('aria-current', String(i === current())));
			dotsEl.hidden = n < 2;
		};

		root.querySelector('.lpc-prev')?.addEventListener('click', () => next(-1));
		root.querySelector('.lpc-next')?.addEventListener('click', () => next(1));
		track.addEventListener('scroll', renderDots, { passive: true });
		window.addEventListener('resize', renderDots);
		renderDots();

		if (root.hasAttribute('data-fit')) {
			const fit = () => {
				const box = track.getBoundingClientRect();
				const all = slides();
				all.forEach((el) => (el.style.minHeight = ''));
				const inView = all.filter((el) => { const r = el.getBoundingClientRect(); return r.left < box.right - 1 && r.right > box.left + 1; });
				const h = Math.max(0, ...inView.map((el) => el.offsetHeight));
				inView.forEach((el) => (el.style.minHeight = `${h}px`));
				track.style.height = h ? `${h}px` : '';
			};
			let t: number | undefined;
			track.addEventListener('scroll', () => { clearTimeout(t); t = window.setTimeout(fit, 120); }, { passive: true });
			window.addEventListener('resize', fit);
			window.addEventListener('load', fit);
			fit();
		}

		const delay = Number(root.dataset.autoplay);
		if (delay && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
			let paused = false;
			['mouseenter', 'focusin', 'touchstart'].forEach((ev) => root.addEventListener(ev, () => (paused = true), { passive: true }));
			['mouseleave', 'focusout'].forEach((ev) => root.addEventListener(ev, () => (paused = false)));
			setInterval(() => { if (!paused && !document.hidden) next(1); }, delay);
		}
	});
</script>
