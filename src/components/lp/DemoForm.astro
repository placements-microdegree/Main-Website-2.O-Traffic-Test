---
// Lead form for the demo pages. Submission is handled by src/scripts/lp.ts (form[data-lead-form]).
interface Props {
	/** Supabase table the lead is inserted into. */
	table: string;
	/** Page shown after a successful submit. */
	redirect: string;
	heading: string;
}
const { table, redirect, heading } = Astro.props;
const field =
	'w-full px-4 py-2.5 border border-neutral-300 rounded-lg placeholder:text-neutral-400 focus:outline-none focus:ring-2 focus:ring-neutral-900 focus:border-neutral-900 transition';
---

<div data-form-wrap class="bg-white py-8 px-6 rounded-2xl border border-neutral-200 shadow-[0_25px_60px_-15px_rgba(0,0,0,0.25)]">
	<div data-loading class="hidden fixed inset-0 z-[99999] bg-white flex flex-col items-center justify-center">
		<div class="flex space-x-2">
			<div class="h-4 w-4 bg-neutral-900 rounded-full animate-bounce [animation-delay:-0.3s]"></div>
			<div class="h-4 w-4 bg-neutral-900 rounded-full animate-bounce [animation-delay:-0.15s]"></div>
			<div class="h-4 w-4 bg-neutral-900 rounded-full animate-bounce"></div>
		</div>
		<p class="mt-4 text-neutral-500 text-sm">Redirecting you to the video...</p>
	</div>

	<form class="space-y-4" data-lead-form data-table={table} data-redirect={redirect} novalidate>
		<h2 class="text-xl font-semibold text-neutral-900 text-center tracking-tight">{heading}</h2>
		<p class="text-sm text-neutral-500 text-center">Enter your details to watch the video 👇</p>

		<p data-error hidden class="text-red-600 text-sm text-center" role="alert"></p>

		<input type="text" name="name" placeholder="Enter your name" autocomplete="name" aria-label="Your name" class={field} />
		<input type="email" name="email" placeholder="Enter your email" autocomplete="email" aria-label="Your email" class={field} />
		<input type="tel" name="number" placeholder="Enter your phone number" autocomplete="tel" aria-label="Your phone number" class={field} />

		<select aria-label="Select Experience" name="experience" class={`${field} text-neutral-700`}>
			<option value="">Select Experience</option>
			<option value="it_working_professional">IT Professional</option>
			<option value="non-it_working_professional">Non-IT Professional</option>
			<option value="fresher-looking_for_job">Fresher</option>
			<option value="student">Student</option>
		</select>

		<button type="submit" class="w-full py-3 bg-blue-500 text-white rounded-lg font-semibold tracking-wide hover:bg-blue-600 transition">
			Watch the Video Now →
		</button>
	</form>
</div>
