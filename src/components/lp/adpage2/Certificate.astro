---
const Certificates = '/img/pyfs/certificates.jpg';
---

<div class="bg-none">
      <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-20 mb-10 mt-10">
        {/* Title */}
        <h2 class="font-poppins text-3xl sm:text-4xl font-semibold text-center mb-12 leading-tight">
          Get Course Completion Certificate
        </h2>

        {/* Grid Layout */}
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
          {/* Left Image */}
          <div class="flex justify-center">
            <div class="w-full sm:w-lg overflow-hidden rounded-md bg-gray-200 shadow-md">
              <img loading="lazy" decoding="async"
                src={Certificates}
                alt="Certificate"
                class="h-full w-full object-cover rounded-md"
              />
            </div>
          </div>

          {/* Right Content */}
          <div class="flex flex-col items-center lg:items-start text-center lg:text-left space-y-6">
            <p class="text-lg sm:text-xl font-medium leading-relaxed">
 Showcase your skills with Course Completion Certificate from Industry experts, validating your Generative AI expertise and boosting your career.
            </p>

            {/* CTA Buttons */}
<div class="flex flex-col sm:flex-row gap-4 justify-center items-center mx-auto pt-6">
        <button type="button" data-scroll-to="hero" class="bg-[#151595] text-white px-12 py-4 rounded-xl font-semibold shadow-lg mb-10">
          Talk to a Counsellor for Free
        </button>
</div>

          </div>
        </div>
      </div>
    </div>
