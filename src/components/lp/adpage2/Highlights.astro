---

<div
      class="w-full py-12 px-6 mt-5 sm:px-10"
      id="courses-section"
      style="scroll-margin-top:96px"
    >
      <div class="max-w-6xl mx-auto">
        {/* 🔹 Title */}
        <h2 class="text-3xl sm:text-4xl font-semibold text-gray-700 mb-10 text-center">
          Program Highlights
        </h2>

        {/* 🔹 Highlights Grid */}
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-12 text-gray-700">
          {highlightsData.map((item, idx) => (
            <div
              class="flex items-start sm:items-center space-x-3 text-left leading-relaxed"
            >
              <div class="flex-shrink-0 mt-1 sm:mt-0 text-blue-600 text-3xl sm:text-3xl">
                <Fragment set:html={item.icon} />
              </div>
              <span class="text-base sm:text-base text-gray-700">
                {item.text}
              </span>
            </div>
          ))}
        </div>

        {/* 🔹 Ratings Section */}
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mb-10">
          <div class="p-6 rounded-lg border border-gray-200 shadow hover:shadow-lg transition-all relative">
