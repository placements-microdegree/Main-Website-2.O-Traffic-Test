---
const OpenAI = '/lp/genai/logo/openai.webp';
const Bedrock = '/lp/adpage/bedrock.png';
const MCP = '/lp/adpage2/mcp.png';
const CrewAI = '/lp/adpage2/crewai.png';
const Dotenv = '/lp/adpage2/dotenv.png';
const Chroma = '/lp/adpage2/chroma.png';
const Gradio = '/lp/adpage2/gradio.png';
const Pinecode = '/lp/adpage2/pinecone.png';
const Pydantic = '/lp/genai/logo/pydantic.webp';
const Jsonschema = '/lp/genai/logo/json.webp';
const Docker = '/lp/adpage2/docker.png';
const Streamlit = '/lp/adpage2/streamlit.png';
const tools = [
  { name: "OpenAI", logo: OpenAI },
  { name: "Bedrock", logo: Bedrock },
  { name: "MCP", logo: MCP },
  { name: "CrewAI", logo: CrewAI },
  { name: "Dotenv", logo: Dotenv },
  { name: "Chroma", logo: Chroma },
  { name: "Gradio", logo: Gradio },
  { name: "Pinecode", logo: Pinecode },
  { name: "Pydantic", logo: Pydantic },
  { name: "Jsonschema", logo: Jsonschema },
  { name: "Docker", logo: Docker },
  { name: "Streamlit", logo: Streamlit },
];
---

<div class="w-full py-12 px-6 sm:px-10">
      {/* Title */}
      <h2 class="font-poppins text-gray-700 text-3xl sm:text-3xl lg:text-4xl font-semibold tracking-tight text-center mb-10">
        Tools Used
      </h2>

      {/* Tools Grid */}
      <div class="max-w-6xl mx-auto grid grid-cols-3 sm:grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-6">
        {tools.map((tool, idx) => (
          <div
            class="bg-white rounded-2xl flex flex-col sm:flex-row items-center justify-center sm:justify-start text-center sm:text-left p-3 sm:p-4 shadow-sm hover:shadow-md transition-all"
          >
            <img loading="lazy" decoding="async"
              src={tool.logo}
              alt={tool.name}
              class="w-9 h-9 sm:w-12 sm:h-12 mb-2 sm:mb-0 sm:mr-4 shrink-0"
            />
            <span class="font-poppins tracking-tight font-medium text-sm sm:text-xl break-words">
              {tool.name}
            </span>
          </div>
        ))}
      </div>
    </div>
