---
const { title, desc, date, month, cardImg } = Astro.props;
---

<div id="recognation" class=" mx-auto sm:mx-0 mb-7 h-76 group relative w-[280px] xl:w-[17.5rem] md:w-[260px] 2xl:w-[320px] 2xl:h-[390px] rounded-2xl overflow-hidden bg-white border border-gray-100 shadow-md hover:shadow-2xl hover:-translate-y-1.5 transition-all duration-300 ease-out">
  <div class="overflow-hidden">
    <img decoding="async" class="w-full object-contain transition-transform duration-500 ease-out group-hover:scale-105" src={cardImg} alt="Sunset in the mountains" loading="lazy"/>
  </div>
  <div class='group-hover:hidden absolute top-3 left-3 w-12 h-12 bg-white rounded-full text-sm font-semibold flex flex-col leading-4 justify-center items-center shadow-md ring-1 ring-black/5'>
    <h1 class='text-yellow-500 font-bold text-[1rem]'>{date}</h1>
    <h1 class='text-[0.7rem] uppercase'>{month}</h1>
  </div>

  <div class="px-4 py-2 2xl:py-4 xl:py-1 h-full bg-white text-left space-y-2">
    <h1 class="truncate font-medium  2xl:font-semibold text-lg 2xl:text-xl ">{title}</h1>
    <p class=" text-gray-700 text-xs xl:text-sm  2xl:text-base">
        {desc}
    </p>
  </div>
</div>
