---
import Carousel from '../Carousel.astro';
import Icon from '../Icon.astro';
const vinayImg = '/lp/adpage2/vinay.jpeg';
const ajeetImg = '/lp/adpage2/ajeet.jpeg';
const vishnuImg = '/lp/adpage2/vishnu-vardhan.jpeg';
const jayanthImg = '/lp/adpage2/jayanth.jpeg';
const manjeImg = '/lp/adpage2/manjegowda.jpeg';
const testimonials = [
  {
    name: "Vinay Kallapur",
    role: "Google Review",
    image: vinayImg,
    rating: 5,
    content:
      "I have enrolled for GEN AI class. They teach from basic of Gen AI and also with Python language. Staff are very friendly and all queries will be noticed and sorted. They actively collect feedback and work on that. Overall experience is good.",
  },
  {
    name: "Ajeet Chavhan",
    role: "Google Review",
    image: ajeetImg,
    rating: 5,
    content:
      "Excellent Generative AI course in Kannada. Easy-to-understand explanations, practical examples, and industry-relevant topics. A great learning experience for beginners and IT professionals.",
  },
  {
    name: "Vishnu Vardhan",
    role: "Google Review",
    image: vishnuImg,
    rating: 5,
    content:
      "I have joined Gen AI course and had a wonderful experience learning new concepts of Agentic AI, LangChain, LangGraph, and RAG systems with hands-on examples and projects.",
  },
  {
    name: "Jayanth Revankar",
    role: "Google Review",
    image: jayanthImg,
    rating: 5,
    content:
      "Had attended GenAI classes with Akash Patil. Akash has been very resourceful, knowledgeable, and had patiently explained concepts clearly.",
  },
  {
    name: "ManjeGowda K S",
    role: "Google Review",
    image: manjeImg,
    rating: 5,
    content:
      "I have completed Phase 1 of the Gen AI course focused on RAG, and the learning experience has been excellent so far. It has provided a great learning curve into the world of AI. The trainer, Pranav Kumar, explained the concepts very clearly and ensured we understood everything during the class itself, making it unnecessary to revisit the recordings again and again. A big thank you to MicroDegree for helping us learn advanced technology in our mother tongue, Kannada.",
  },
];

const colorPalette = [
  { bg: "bg-red-100", text: "text-red-600" },
  { bg: "bg-blue-100", text: "text-blue-600" },
  { bg: "bg-green-100", text: "text-green-600" },
  { bg: "bg-purple-100", text: "text-purple-600" },
  { bg: "bg-pink-100", text: "text-pink-600" },
  { bg: "bg-yellow-100", text: "text-yellow-600" },
  { bg: "bg-indigo-100", text: "text-indigo-600" },
];
const getColorForName = (index) => colorPalette[index % colorPalette.length];
const getInitial = (name) => name.charAt(0).toUpperCase();
const truncateText = (text, limit = 200) => (text.length <= limit ? text : text.substring(0, limit) + '...');
---

<section class="py-16 px-4">
  {/* Header */}
  <div class="text-center mb-12">
    <h1 class="font-poppins text-3xl sm:text-3xl lg:text-4xl text-gray-700">
      <span class="font-semibold">Learners Success Stories</span>
    </h1>
  </div>

  {/* Slider (react-slick: 3 / 2 / 1 slides, autoplay 4s) */}
  <div class="max-w-7xl mx-auto">
    <Carousel show={3} showTablet={2} showMobile={1} autoplay={4000} loop>
      {testimonials.map((item) => (
        <div class="px-3 h-full">
          <div class="mx-auto max-w-[420px] h-full bg-white border border-gray-200 rounded-2xl p-6 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col">
            {/* Avatar + Name */}
            <div class="flex items-center gap-4 mb-4">
              <img loading="lazy" decoding="async" src={item.image} alt={item.name} class="w-12 h-12 rounded-full object-cover" />
              <div class="flex-1 text-left">
                <h3 class="font-semibold text-gray-900">{item.name}</h3>
                <p class="text-xs text-gray-500">{item.role}</p>
              </div>
            </div>

            {/* Stars */}
            <div class="mb-3 flex justify-start">
              <div class="flex gap-1 text-[14px]">
                {[...Array(5)].map((_, i) => (
                  <span class={i < item.rating ? 'text-yellow-400' : 'text-gray-300'}><Icon name="FaStar" /></span>
                ))}
              </div>
            </div>

            {/* Review */}
            <p class="text-gray-600 text-sm leading-relaxed text-left flex-1">{truncateText(item.content)}</p>
          </div>
        </div>
      ))}
    </Carousel>
  </div>
</section>
