---
import AdDemoForm from '../AdDemoForm.astro';
const gif1 = '/lp/adpage2/gif-1-.webp';
---

<div class="py-10 px-1 sm:px-4" id="demo">
	<div class="max-w-7xl mx-auto p-1 lg:p-8">
		<div class="text-center max-w-6xl mx-auto mb-10">
			<h1 class="text-3xl text-[#151595] sm:text-4xl font-semibold leading-tight mb-5">Still stuck in the roles getting replaced by AI?</h1>
			<p class="text-2xl sm:text-2xl lg:text-3xl font-semibold text-gray-700">Take a Free Demo Now 👇🏼</p>
		</div>

		<div class="grid grid-cols-1 lg:grid-cols-2 gap-0 max-w-7xl mx-auto rounded-3xl bg-white shadow-sm overflow-hidden">
			<div class="flex items-center justify-center p-4 lg:p-6 lg:min-h-[380px]">
				<div class="relative w-full rounded-2xl overflow-hidden">
					<img loading="lazy" decoding="async" src={gif1} alt="Generative AI demo session" class="w-full max-h-[260px] object-contain" />
				</div>
			</div>

			<div class="flex flex-col justify-center gap-4 px-6 pb-6 pt-2 lg:p-10 text-center lg:text-left lg:min-h-[380px]">
				<h3 class="text-xl sm:text-2xl lg:text-3xl font-semibold text-gray-800">AI for IT Professionals: Where Do I Start in 2026</h3>
				<div>
					<button type="button" data-dialog-open="ad-demo-1" class="inline-flex items-center justify-center rounded-xl border border-[#151595] bg-[#151595] px-8 py-3 text-white transition duration-300 hover:bg-white hover:text-[#151595]">Watch Free Demo →</button>
				</div>
			</div>
		</div>
	</div>

	<dialog id="ad-demo-1" data-dialog class="ad-modal">
		<div class="relative w-full">
			<button type="button" data-dialog-close aria-label="Close" class="absolute -top-3 -right-3 z-10 bg-white rounded-full w-8 h-8 shadow flex items-center justify-center text-gray-600 hover:text-black">✕</button>
			<AdDemoForm table="demo_genai" redirect="/demovideo3" heading="AI for IT Professionals: Where Do I Start in 2026" />
		</div>
	</dialog>
</div>

<style is:global>
	dialog.ad-modal { background: transparent; padding: 1rem; max-width: 28rem; width: 100%; margin: auto; overflow: visible; border: 0; }
	dialog.ad-modal::backdrop { background: rgb(0 0 0 / .4); backdrop-filter: blur(12px); }
	body:has(dialog[open]) { overflow: hidden; }
</style>
