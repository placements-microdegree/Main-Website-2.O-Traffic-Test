<div class="w-full py-12 px-6 sm:px-10" id="curriculum">
  <div class="max-w-6xl mx-auto" data-tabs>

    {/* Header */}
    <div class="flex flex-col sm:flex-row items-start sm:items-center sm:justify-between py-5">
      <h2 class="text-3xl sm:text-4xl font-semibold text-gray-700 text-left">Course Curriculum</h2>

      {/* Toggle (visible on mobile) */}
      <div class="flex w-full sm:w-auto bg-gray-200 p-1 rounded-full mt-4 sm:mt-0">
        <button type="button" data-tab="premium" data-on="bg-blue-600 text-white" data-off="text-gray-700" aria-pressed="true" class="flex-1 sm:flex-none px-5 py-2 rounded-full text-sm font-medium transition bg-blue-600 text-white">Premium</button>
        <button type="button" data-tab="premiumPlus" data-on="bg-blue-600 text-white" data-off="text-gray-700" aria-pressed="false" class="flex-1 sm:flex-none px-5 py-2 rounded-full text-sm font-medium transition text-gray-700">Premium+</button>
      </div>
    </div>

    {/* Curriculum */}
    {[['premium', premiumData], ['premiumPlus', premiumPlusData]].map(([key, data]) => (
      <div data-tab-panel={key} hidden={key !== 'premium'} class="space-y-3">
        {data.map((item) => (
          <details name={`dc-${key}`} class="dc-acc border rounded-md shadow-sm hover:shadow-md transition">
            <summary class="w-full flex justify-between items-start p-4 cursor-pointer text-left">
              <div class="flex items-start space-x-3 w-full">
                <span class="h-2 w-2 rounded-full bg-blue-600 mt-2"></span>
                <span class="font-medium text-gray-800 text-left w-full leading-tight">{item.title}</span>
              </div>
              <i class="fa-solid fa-chevron-down text-gray-500 mt-1 transition-transform"></i>
            </summary>
            <div class="px-6 pb-4 text-gray-600 text-left">
              <ul class="list-disc pl-6 space-y-1 text-left w-full">
                {item.desc.map((point) => <li class="text-left">{point}</li>)}
              </ul>
            </div>
          </details>
        ))}
      </div>
    ))}

    {/* Bottom */}
    <div class="font-semibold text-md sm:text-xl text-center mt-5 mb-5">Download Complete Curriculum for more details.</div>

    {/* Mobile Button */}
    <div class="flex justify-center mt-6">
      <a
        href="#tally-open=mZ46gA&tally-emoji-text=👋&tally-emoji-animation=wave"
        class="flex items-center justify-center gap-2 px-8 py-3 bg-[#151595] text-white px-12 py-4 rounded-xl font-semibold shadow-lg mb-10"
      >
        <i class="fa-solid fa-download text-white text-sm"></i>
        Click here to Download
      </a>
    </div>
  </div>
</div>

<style is:global>
  .dc-acc > summary { list-style: none; }
  .dc-acc > summary::-webkit-details-marker { display: none; }
  .dc-acc[open] > summary i { transform: rotate(180deg); }
</style>
