<div>
      <section class="py-12 mb-10 lg:py-16" id="pricing">
        {/* make container wider */}
        <div class="max-w-7xl px-6 mx-auto">
          <h2 class="text-3xl sm:text-3xl lg:text-4xl text-gray-700 font-semibold mb-10">
            Invest in Skills That Move Your Tech Career Forward
          </h2>

          <div class="relative overflow-hidden rounded-3xl border border-gray-200 bg-white shadow-sm">

            {/* Header band */}
            <div class="relative border-b border-gray-200 bg-white px-8 py-6 sm:px-12 text-center">
              <div class="mx-auto mb-6 inline-flex h-14 w-14 rotate-3 items-center justify-center rounded-2xl border border-[#151595] bg-white text-[#151595] shadow-sm">
                <svg aria-hidden="true" stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 448 512" class="text-xl" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path d="M224.3 273l-136 136c-9.4 9.4-24.6 9.4-33.9 0l-22.6-22.6c-9.4-9.4-9.4-24.6 0-33.9l96.4-96.4-96.4-96.4c-9.4-9.4-9.4-24.6 0-33.9L54.3 103c9.4-9.4 24.6-9.4 33.9 0l136 136c9.5 9.4 9.5 24.6.1 34zm192-34l-136-136c-9.4-9.4-24.6-9.4-33.9 0l-22.6 22.6c-9.4 9.4-9.4 24.6 0 33.9l96.4 96.4-96.4 96.4c-9.4 9.4-9.4 24.6 0 33.9l22.6 22.6c9.4 9.4 24.6 9.4 33.9 0l136-136c9.4-9.2 9.4-24.4 0-33.8z"></path></svg>
              </div>

              {/* Heading */}
              <h2 class="text-3xl sm:text-4xl font-semibold">
                Pricing Plan
              </h2>
            </div>

            {/* Body */}
            <div class="relative px-8 pt-10 pb-8 sm:px-12 text-center">
              {/* Description */}
              <p class="text-lg sm:text-xl text-gray-700 mb-10 leading-relaxed max-w-3xl mx-auto">
                Get our detailed pricing straight to your inbox — just fill out
                the form below with your details.
              </p>

              {/* Button */}
              <div class="flex justify-center">
                <a
                  href="#tally-open=w8vg6A&tally-emoji-text=👋&tally-emoji-animation=wave"
                  class="flex items-center justify-center gap-2 px-8 py-3 border-2 border-[#151595] bg-[#151595] text-white font-semibold rounded-lg text-base hover:bg-white hover:text-[#151595] transition-all duration-300 shadow-lg hover:shadow-[0_8px_25px_rgba(21,21,149,0.4)]"
                >
                  <svg aria-hidden="true" stroke="currentColor" fill="currentColor" stroke-width="0" viewBox="0 0 448 512" height="1em" width="1em" xmlns="http://www.w3.org/2000/svg"><path d="M224.3 273l-136 136c-9.4 9.4-24.6 9.4-33.9 0l-22.6-22.6c-9.4-9.4-9.4-24.6 0-33.9l96.4-96.4-96.4-96.4c-9.4-9.4-9.4-24.6 0-33.9L54.3 103c9.4-9.4 24.6-9.4 33.9 0l136 136c9.5 9.4 9.5 24.6.1 34zm192-34l-136-136c-9.4-9.4-24.6-9.4-33.9 0l-22.6 22.6c-9.4 9.4-9.4 24.6 0 33.9l96.4 96.4-96.4 96.4c-9.4 9.4-9.4 24.6 0 33.9l22.6 22.6c9.4 9.4 24.6 9.4 33.9 0l136-136c9.4-9.2 9.4-24.4 0-33.8z"></path></svg>
                  Get Your Plan Now
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>
