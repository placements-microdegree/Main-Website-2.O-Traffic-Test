---
const Cloud2 = '/lp/adpage2/i.webp';
---

<div id="course">

      {/* Header */}
      <h1 class="font-poppins tracking-tight text-3xl sm:text-3xl lg:text-4xl text-gray-700 mb-16 mt-10 text-center">
        <span class="font-semibold">Our Generative AI Program</span>
      </h1>

      {/* Wider Container */}
      <div class="max-w-7xl mx-auto px-6 lg:px-8 mb-16">

        {/* ------------ CARD ------------ */}
        <div class="bg-white rounded-2xl shadow-xl border border-gray-100 overflow-hidden h-full grid grid-cols-1 md:grid-cols-2">

          {/* Side Image */}
          <div class="relative w-full h-48 sm:h-64 md:h-auto">
            <img loading="lazy" decoding="async"
              src={Cloud2}
              alt="AI Program"
              class="w-full h-full object-cover md:absolute md:inset-0"
            />
          </div>

          {/* Content */}
          <div class="px-6 py-5 md:px-10 md:py-10 flex flex-col justify-center">

            <h1 class="text-2xl text-left font-semibold text-gray-800 mb-2">
              Generative AI &amp; Agentic AI Certification Program
            </h1>

            <p class="text-gray-600 text-left text-base mb-5">
              Master Generative AI, LLMs, Prompt Engineering, RAG, and Agentic AI Systems.
            </p>

