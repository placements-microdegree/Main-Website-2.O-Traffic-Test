---
const KA = '/lp/prime/ka.png';
const HP = '/lp/prime/hp.png';
const PR = '/lp/prime/prime.webp';
---

<section class="relative overflow-hidden font-poppins bg-light text-dark mb-10">
      {/* Background gradient */}
      <div class="absolute inset-0 bg-gradient-to-br from-primary/5 via-light to-secondary/5 -z-10" />

      {/* Karnataka Map Outline (Background) */}
      <div class="absolute top-24 sm:top-1 right-0 bottom-0 w-[430px] opacity-20 -z-10">
        <img
          src={KA}
          alt="Karnataka Map Outline"
          class="w-full h-auto"
          loading="lazy"
          decoding="async"
        />
      </div>

      {/* Hampi outline */}
      <div
        class="absolute left-1/2 -translate-x-1/2 sm:-translate-x-1/4 bottom-0 w-[180px] sm:w-[240px] opacity-35 -z-10"
        aria-hidden="true"
      >
        <img
          src={HP}
          alt="Hampi Outline"
          class="w-full h-auto mix-blend-multiply"
          loading="lazy"
          decoding="async"
        />
      </div>

      {/* Floating circles */}
      <div class="absolute top-20 left-10 w-16 h-16 rounded-full bg-primary/10 animate-float -z-10" />
      <div class="absolute top-1/3 right-20 w-24 h-24 rounded-full bg-secondary/10 animate-float-reverse -z-10" />
      <div class="absolute bottom-20 left-1/4 w-20 h-20 rounded-full bg-primary/15 animate-float -z-10" />
      <div class="absolute bottom-1/3 right-1/4 w-32 h-32 rounded-full bg-secondary/15 animate-float-reverse -z-10" />

      {/* Main content */}
      <div class="max-w-7xl mx-auto px-4 sm:px-6 mb-5 lg:px-8 py-8 md:py-16">
        <div class="flex flex-col md:grid md:grid-cols-2 md:gap-x-12 md:gap-y-0 md:items-start">
          {/* LEFT */}
          <div class="order-1 md:order-1 text-left">
            <h1 class="text-[32px] sm:text-4xl lg:text-4xl font-semibold text-[#3d56ec] !leading-[1.14] mb-6">
              Master Top IT Skills and Become the #1 Choice of Recruiters
            </h1>

            <h2 class="text-xl sm:text-2xl lg:text-2xl font-medium !leading-[1.18] mb-16">
              Build expertise in Cloud Computing, DevOps, Automation, AI and Data Analytics at an affordable price.
            </h2>

            {/* DESKTOP buttons */}
            <div class="hidden md:flex flex-row gap-4">
              <a href="https://rzp.io/rzp/ejGVnSa" class="relative">
                <span class="absolute top-0 left-0 mt-1 ml-1 h-full w-full rounded bg-gray-700"></span>
                <span class="fold-bold relative inline-block h-full w-full rounded border-2 border-black bg-[#3d56ec] px-3 py-2 text-lg font-semibold text-white transition duration-100 hover:bg-gray-900 hover:text-white">
                  Start Now at 299/month
                </span>
              </a>
              <a
                class="relative cursor-pointer"
                data-scroll-to="intro"
              >
                <span class="absolute top-0 left-0 mt-1 ml-1 h-full w-full rounded bg-black"></span>
                <span class="fold-bold relative inline-block h-full w-full rounded border-2 border-black bg-white px-3 py-2 text-lg font-semibold text-black transition duration-100 hover:bg-gray-900 hover:text-white">
                  Learn More
                </span>
              </a>
            </div>
          </div>

          {/* RIGHT */}
          <div class="relative order-2 md:order-2 animate__animated animate__fadeIn">
            <div class="relative max-w-md mx-auto">
              <div class="absolute -top-10 -left-10 w-32 h-32 bg-primary/10 rounded-2xl -z-10 animate-float" />
              <div class="absolute -bottom-10 -right-10 w-32 h-32 bg-secondary/10 rounded-2xl -z-10 animate-float-reverse" />

              {/* Static image instead of video */}
              <div class="relative rounded-xl shadow-2xl border-8 border-white overflow-hidden">
                <div class="relative w-full pt-[56.25%]">
                  <img
                    src={PR}
                    alt="MicroDegree students learning Cloud Computing, DevOps, AI and Data Analytics"
                    class="absolute inset-0 w-full h-full object-cover"
                    loading="eager"
                    fetchpriority="high"
                    decoding="async"
                  />
                </div>
              </div>
            </div>

            {/* Badges */}
            <div class="absolute -bottom-8 left-1/4 bg-white px-4 py-2 rounded-lg shadow-md flex items-center">
              <div class="w-3 h-3 bg-green-500 rounded-full mr-2 animate-pulse" />
              <span class="text-sm font-medium">25+ Courses</span>
            </div>
            <div class="absolute -top-8 right-1/4 flex items-center gap-2">
              <div class="bg-white px-4 py-2 rounded-lg shadow-md">
                <span class="text-sm font-medium">Learn 10x faster In <span class="font-semibold">ಕನ್ನಡ</span></span>
              </div>
              <div class="w-10 h-8 rounded-tl-lg rounded-br-lg shadow-md overflow-hidden flex flex-col">
                <div class="flex-1 bg-yellow-400"></div>
                <div class="flex-1 bg-red-600"></div>
              </div>
            </div>
          </div>

          {/* MOBILE buttons */}
          <div class="order-3 md:hidden flex flex-col gap-5 mt-16">
            <a href="https://rzp.io/rzp/ejGVnSa" class="relative">
              <span class="absolute top-0 left-0 mt-1 ml-1 h-full w-full rounded bg-gray-700"></span>
              <span class="fold-bold relative inline-block h-full w-full rounded border-2 border-gray-700 bg-[#3d56ec] px-3 py-2 text-xl font-semibold text-white transition duration-100 hover:bg-gray-900 hover:text-white">
                Start Now at 299/month
              </span>
            </a>
            <a
              class="relative cursor-pointer"
              data-scroll-to="intro"
            >
              <span class="absolute top-0 left-0 mt-1 ml-1 h-full w-full rounded bg-black"></span>
              <span class="fold-bold relative inline-block h-full w-full rounded border-2 border-gray-700 bg-white px-3 py-2 text-xl font-semibold text-black transition duration-100 hover:bg-gray-900 hover:text-white">
                Learn More
              </span>
            </a>
          </div>
        </div>
      </div>
    </section>
  );
});

export default Herox;
