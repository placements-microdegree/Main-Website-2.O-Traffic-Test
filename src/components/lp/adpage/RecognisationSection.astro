---
import RecognisationCard from './RecognisatonCard.astro';
const NidhiSeed = '/img/recog/NidhiSeed.webp';
---

<div class='h-full sm:py-20 sm:px-14 xl:px-18 2xl:px-20 space-y-2 2xl:mt-0 mt-[70px] md:mt-[5px]'>
    <div class='space-y-6'>
    <h1 class='font-poppins tracking-tight font-bold text-3xl sm:text-3xl lg:text-4xl'><span class='font-semibold'>Awards & Recognition</span></h1>
    <p class=" text-gray-600 text-xs xl:text-sm 2xl:text-base font-md mx-2">MicroDegree is proud to be acknowledged by some prominent publications and organizations</p>
    
    </div>

    <div class=" w-full h-full flex flex-wrap space-x-2 items-center justify-around 2xl:justify-center 2xl:space-x-20 align-center px-10 sm:px-24">
      <img decoding="async" class=" w-[89px] xl:w-36 2xl:w-[200px] sm:w-32 object-contain transition-transform duration-300 ease-out hover:scale-110" src="https://ik.imagekit.io/MicroDegree/Website/homeWebp/Section3/brandLogo1.png?updatedAt=1681880924879" alt="" loading="lazy"/>
      <img decoding="async" class=" w-[89px] xl:w-36 2xl:w-[200px] sm:w-32 object-contain transition-transform duration-300 ease-out hover:scale-110" src="https://ik.imagekit.io/MicroDegree/Website/homeWebp/Section3/brandLogo2.png?updatedAt=1681880925403" alt="" loading="lazy"/>
      <img decoding="async" class=" w-[89px] xl:w-36 2xl:w-[200px] sm:w-32 object-contain transition-transform duration-300 ease-out hover:scale-110" src="https://ik.imagekit.io/MicroDegree/Website/homeWebp/Section3/brandLogo3.png?updatedAt=1681880926709" alt="" loading="lazy"/>
      <img decoding="async" class=" w-[89px] xl:w-36 2xl:w-[200px] sm:w-32 object-contain transition-transform duration-300 ease-out hover:scale-110" src="https://ik.imagekit.io/MicroDegree/Website/homeWebp/Section3/brandLogo5.png?updatedAt=1681880927885" alt="" loading="lazy"/>
    </div>

    <div class="flex flex-wrap items-center justify-around 2xl:justify-center sm:space-x-2 2xl:space-x-8 ">
      <RecognisationCard title='Karnataka Digital Economy Mission Recognition at BTS' desc='MicroDegree receiving award for its impactful work at grass root levels.' date='21' month='nov' cardImg="https://ik.imagekit.io/MicroDegree/Website/homeWebp/Section3/a1.webp?updatedAt=1681880924629" />
      <RecognisationCard title='Winning Startup Elevate 2020' desc='MicroDegree chosen as one of the top 100 startups by Govt. of Karnataka.' date='20' month='mar' cardImg="https://ik.imagekit.io/MicroDegree/Website/homeWebp/Section3/a2.webp?updatedAt=1681880924588" />
      <RecognisationCard title='Awarded by IEEE' desc='MicroDegree impacted 3000+ rural talent imparting tech sessions in Kannada.' date='21' month='feb' cardImg="https://ik.imagekit.io/MicroDegree/Website/homeWebp/Section3/a3.webp?updatedAt=1681880924644" />
      <RecognisationCard title='NIDHI Seed Support Program' desc='MicroDegree featured among 75 promising startups in the Azadi Ka Amrit Mahotsav compendium' date='16' month='jan' cardImg={NidhiSeed} />
      
    </div>
  </div>
