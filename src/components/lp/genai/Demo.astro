---
import Icon from '../Icon.astro';

const DemoImage = '/lp/awsdevops/logo/demo.webp';
const DemoPreview = '/lp/genai/logo/genai2.webp';
const DemoVideo = '/lp/genaidemo/genai-hero.mp4';
const points = [
  'Step-by-step roadmap to build a Gen AI career',
  'What are LLMs, RAG & AI Agents (in simple terms)',
  'What is Agentic AI & why it’s important.',
  'Real-world Gen AI use cases and career paths',
];
---

<section class="px-4 sm:px-6 mt-16 mb-12" id="abcd">
  <div id="section2" class="max-w-6xl mx-auto rounded-3xl border border-[#e4e6f2] bg-white p-4 sm:p-6 lg:p-8 shadow-[0_10px_30px_-22px_rgba(65,89,236,0.2)]">
    <div class="grid lg:grid-cols-12 gap-6 items-stretch">
      {/* Left: what you will learn */}
      <div class="lg:col-span-7 rounded-2xl bg-white border border-[#e4e6f2] p-6 sm:p-8 flex flex-col">
        <div class="w-full">
          <h2 id="genai-demo" class="font-poppins tracking-tight text-3xl lg:text-4xl font-semibold text-gray-900 text-center lg:text-left">
            Take a Free Demo Today
          </h2>
          <p class="mt-3 font-poppins text-gray-600 text-base sm:text-lg text-center lg:text-left">
            In this Exclusive Demo Session, you will learn:
          </p>
        </div>

        <div class="mt-6 flex flex-1 flex-col lg:flex-row items-center lg:items-end gap-6 lg:gap-8">
          <div class="hidden lg:block lg:w-[34%] shrink-0">
            <img
              loading="lazy"
              decoding="async"
              src={DemoImage}
              alt="Generative AI course free demo session by MicroDegree"
              class="w-full h-auto max-h-[330px] object-contain object-bottom"
            />
          </div>

          <ul class="w-full space-y-4 text-left lg:self-center">
            {points.map((point) => (
              <li class="flex items-start gap-3">
                <span class="mt-0.5 grid h-6 w-6 shrink-0 place-items-center rounded-full bg-[#eef0ff] text-[#4159ec]">
                  <Icon name="FaCheckCircle" class="h-4 w-4" />
                </span>
                <span class="font-poppins text-[16px] sm:text-[17px] leading-snug text-gray-800">{point}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>

      {/* Right: preview + schedule + CTA */}
      <div class="lg:col-span-5 rounded-2xl bg-white border border-[#e4e6f2] shadow-[0_12px_30px_-18px_rgba(18,18,43,0.25)] p-5 sm:p-6 flex flex-col">
        <h3 class="font-poppins tracking-tight text-lg sm:text-xl font-semibold text-gray-900 leading-snug">
          AI for IT Professionals: Where Do I Start in 2026
        </h3>

        <div class="mt-4 overflow-hidden rounded-xl ring-1 ring-black/5">
          <video
            src={DemoVideo}
            poster={DemoPreview}
            aria-label="Preview of the MicroDegree Generative AI free demo session"
            class="block w-full h-auto"
            autoplay
            loop
            muted
            playsinline
          />
        </div>

        <a
          href="/genaidemo"
          class="mt-5 lg:mt-auto block w-full rounded-xl text-center bg-[#ff0055] px-6 py-3.5 font-poppins text-lg font-semibold text-white shadow-[0_12px_24px_-10px_rgba(255,0,85,0.7)] transition-all duration-200 hover:-translate-y-0.5 active:translate-y-0"
        >
          Take a Free Demo
        </a>
      </div>
    </div>
  </div>
</section>
