---
import Icon from '../Icon.astro';
const Certificates = '/lp/awsdevops/logo/certificates.webp';
---

<section class="px-4 sm:px-6 my-14">
  <div class="relative max-w-6xl mx-auto overflow-hidden rounded-3xl border border-[#e4e6f2] bg-white p-6 sm:p-10 lg:p-14 shadow-[0_10px_30px_-22px_rgba(65,89,236,0.2)]">
    <div class="relative grid lg:grid-cols-2 gap-10 lg:gap-14 items-center">
      {/* Certificate */}
      <div class="flex justify-center">
        <div class="w-full max-w-lg rounded-2xl bg-white p-2 sm:p-3 shadow-[0_24px_50px_-20px_rgba(18,18,43,0.35)] ring-1 ring-black/5 lg:-rotate-2 transition-transform duration-300 hover:rotate-0 hover:-translate-y-1">
          <img
            loading="lazy"
            decoding="async"
            src={Certificates}
            alt="Sample Generative AI course completion certificate awarded by MicroDegree"
            class="h-auto w-full rounded-xl"
          />
        </div>
      </div>

      {/* Text */}
      <div class="flex flex-col items-center lg:items-start text-center lg:text-left">
        <h2 class="font-poppins text-3xl sm:text-4xl font-semibold leading-tight tracking-tight text-gray-900">
          Get Course Completion Certificate
        </h2>
        <span class="mt-4 block h-1 w-14 rounded-full bg-blue-600"></span>

        <p class="mt-6 font-poppins text-base sm:text-lg leading-relaxed text-gray-600">
          Showcase your skills with Course Completion Certificate from Industry experts, validating your Generative AI expertise and boosting your career.
        </p>

        <a
          href="#"
          data-tally="wbOQP7"
          class="mt-8 inline-flex items-center justify-center gap-2 rounded-xl bg-[#ff0055] px-7 py-3.5 text-sm sm:text-base font-semibold text-white shadow-[0_12px_24px_-10px_rgba(255,0,85,0.7)] transition-all duration-200 hover:-translate-y-0.5 active:translate-y-0"
        >
          <Icon name="FaPlay" class="text-white text-sm" />
          Join Generative AI Certification Program
        </a>
      </div>
    </div>
  </div>
</section>
