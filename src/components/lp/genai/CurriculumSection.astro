// Combine parts into one list, numbering the modules continuously
const combineParts = (...parts) =>
  parts.flat().map((m, i) => ({
    ...m,
    title: m.title.replace(/^Module \d+/, `Module ${i + 1}`),
  }));

const standardData = part1Data;
const premiumData = combineParts(part1Data, part2Data);
const premiumPlusData = combineParts(part1Data, part2Data, part3Data);
const INITIAL_VISIBLE = 10;

const planOptions = [
  { value: "standard", label: "Standard", data: standardData },
  { value: "premium", label: "Premium", data: premiumData },
  { value: "premiumPlus", label: "Premium+", data: premiumPlusData },
];
---

<section class="w-full py-12 px-6 sm:px-10" data-curriculum>
  <div class="max-w-6xl mx-auto">
    <div class="flex flex-col sm:flex-row items-start sm:items-center sm:justify-between py-5">
      <h2 class="text-3xl sm:text-4xl font-semibold text-gray-900 text-left tracking-tight">Generative AI Course Curriculum</h2>

      <div class="flex w-full sm:w-auto mt-4 sm:mt-0 bg-gray-200 p-1 rounded-full" role="tablist">
        {planOptions.map((o) => (
          <button type="button" role="tab" data-plan-tab={o.value} aria-selected={o.value === "premium"} class="plan-tab flex-1 sm:flex-none px-2 sm:px-5 py-2 rounded-full text-[13px] sm:text-sm font-medium whitespace-nowrap transition text-gray-700">
            {o.label}
          </button>
        ))}
      </div>
    </div>

    {planOptions.map((o) => (
      <div data-plan={o.value} hidden={o.value !== "premium"}>
        <p class="text-sm font-medium text-blue-600 mb-3 text-left">{o.data.length} modules</p>
        <div class="space-y-3">
          {o.data.map((item, idx) => (
            <details class:list={["lp-acc border rounded-xl shadow-sm hover:shadow-md transition-shadow duration-300", idx >= INITIAL_VISIBLE && "hidden"]} data-extra={idx >= INITIAL_VISIBLE ? "" : undefined}>
              <summary class="w-full flex justify-between items-start p-4 cursor-pointer text-left">
                <div class="flex items-start space-x-3 w-full">
                  <span class="h-2 w-2 rounded-full bg-blue-600 mt-2 shrink-0"></span>
                  <span class="font-medium text-gray-800 text-left w-full leading-tight">{item.title}</span>
                </div>
                <Icon name="FiChevronDown" class="lp-acc-chevron" />
              </summary>
              <div class="px-6 pb-4 text-gray-600 text-left">
                <ul class="list-disc pl-6 space-y-1 text-left w-full">
                  {item.desc.map((point) => <li class="text-left">{point}</li>)}
                </ul>
              </div>
            </details>
          ))}
        </div>
        {o.data.length > INITIAL_VISIBLE && (
          <div class="flex justify-center mt-5">
            <button type="button" data-more data-count={o.data.length - INITIAL_VISIBLE} class="flex items-center gap-2 px-6 py-2.5 border border-blue-600 text-blue-600 hover:bg-blue-600 hover:text-white font-semibold rounded-full text-sm transition">
              Show {o.data.length - INITIAL_VISIBLE} more modules
            </button>
          </div>
        )}
      </div>
    ))}

    <div class="font-semibold text-md sm:text-xl text-center mt-5 mb-5">Download Complete Curriculum for more details.</div>

    <div class="flex justify-center mt-6">
      <a href="#" data-tally="mZ46gA" class="flex items-center justify-center gap-2 px-8 py-3 bg-blue-600 hover:bg-black text-white font-semibold rounded-lg shadow-sm hover:shadow-lg text-sm sm:text-base transition-all duration-200 hover:-translate-y-0.5 active:translate-y-0">
        <Icon name="FaDownload" class="text-white text-sm" />
        Click here to Download
      </a>
    </div>
  </div>
</section>

<style is:global>
  .lp-acc summary { list-style: none; }
  .lp-acc summary::-webkit-details-marker { display: none; }
  .lp-acc[open] .lp-acc-chevron { transform: rotate(180deg); }
  .lp-acc-chevron { transition: transform .2s; flex: none; }
  [data-curriculum] .plan-tab[aria-selected="true"] { background: #2563eb; color: #fff; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-curriculum]').forEach((root) => {
    const tabs = root.querySelectorAll<HTMLButtonElement>('[data-plan-tab]');
    tabs.forEach((tab) =>
      tab.addEventListener('click', () => {
        tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
        root.querySelectorAll<HTMLElement>('[data-plan]').forEach((p) => (p.hidden = p.dataset.plan !== tab.dataset.planTab));
      }),
    );
    root.querySelectorAll<HTMLButtonElement>('[data-more]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const expanded = btn.dataset.open !== 'true';
        btn.dataset.open = String(expanded);
        btn.closest('[data-plan]')!.querySelectorAll('[data-extra]').forEach((el) => el.classList.toggle('hidden', !expanded));
        btn.textContent = expanded ? 'Show less' : `Show ${btn.dataset.count} more modules`;
      });
    });
  });
</script>
