---
import Icon from '../Icon.astro';
---

<section class="px-4 sm:px-6 my-14">
  <div class="relative max-w-6xl mx-auto overflow-hidden rounded-3xl border border-[#e4e6f2] bg-white px-6 py-10 sm:px-10 lg:px-14 lg:py-12 shadow-[0_10px_30px_-22px_rgba(65,89,236,0.2)]">
    <div class="relative flex flex-col lg:flex-row lg:items-center lg:justify-between gap-8 text-center lg:text-left">
      <div class="max-w-2xl">
        <h2 class="font-poppins text-3xl sm:text-4xl font-semibold tracking-tight text-gray-900">Pricing Plan</h2>
        <span class="mt-4 mx-auto lg:mx-0 block h-1 w-14 rounded-full bg-blue-600"></span>
        <p class="mt-5 font-poppins text-base sm:text-lg leading-relaxed text-gray-600">
          Get our detailed pricing straight to your inbox — just fill out the form below with your details.
        </p>
      </div>

      <a
        href="#"
        data-tally="w8vg6A"
        class="shrink-0 inline-flex items-center justify-center gap-2 self-center rounded-xl border-2 border-[#151595] bg-[#151595] px-8 py-3.5 text-base font-semibold text-white shadow-lg transition-all duration-300 hover:-translate-y-0.5 hover:bg-white hover:text-[#151595] active:translate-y-0"
      >
        <Icon name="FaAngleDoubleRight" />
        Get Your Plan Now
      </a>
    </div>
  </div>
</section>
