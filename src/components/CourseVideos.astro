---
const videos = [
	{ id: '6ZGtOe---X8', title: 'Cloud and DevOps Full Course' },
	{ id: '1ciWsHm-fS4', title: 'Introduction to AWS in Kannada' },
	{ id: 'sVlo7W3iDDQ', title: 'DevOps Fundamentals in Kannada' },
	{ id: 'eg39UDZpMPc', title: 'CI/CD Pipeline in Kannada' },
	{ id: 'bPT9ETxtwpg', title: 'Containerization with Docker in Kannada' },
];
---

<section class="section videos">
	<div class="wrap">
		<div class="section-head"><h2 id="course-videos-heading">Checkout our Full Course Videos</h2></div>
		<div class="rail" id="vid-rail">
			{videos.map((v) => (
				<figure class="card vid">
					<div class="frame">
						<iframe src={`https://www.youtube.com/embed/${v.id}`} title={v.title} loading="lazy" allow="autoplay; encrypted-media" allowfullscreen></iframe>
					</div>
					<figcaption>{v.title}</figcaption>
				</figure>
			))}
		</div>
		<div class="ctrl">
			<button aria-label="Previous video" data-d="-1"><i class="fa-solid fa-chevron-left"></i></button>
			<button aria-label="Next video" data-d="1"><i class="fa-solid fa-chevron-right"></i></button>
		</div>
	</div>
</section>

<style>
	.rail { display: flex; gap: 22px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; padding: 6px 2px 14px; }
	.rail::-webkit-scrollbar { display: none; }
	.vid { flex: 0 0 calc((100% - 44px) / 3); scroll-snap-align: start; margin: 0; overflow: hidden; }
	.frame { aspect-ratio: 16 / 9; background: #000; }
	iframe { width: 100%; height: 100%; border: 0; }
	figcaption { padding: 14px 18px; font-weight: 600; font-size: .95rem; }
	.ctrl { display: flex; justify-content: center; gap: 12px; margin-top: 18px; }
	.ctrl button { width: 44px; height: 44px; border-radius: 50%; border: 1px solid var(--line); background: #fff; color: var(--brand-dark); transition: background .2s, color .2s; }
	.ctrl button:hover { background: var(--brand-dark); color: #fff; }
	@media (max-width: 1000px) { .vid { flex-basis: calc((100% - 22px) / 2); } }
	@media (max-width: 640px) { .vid { flex-basis: 100%; } }
</style>

<script>
	const rail = document.getElementById('vid-rail') as HTMLElement;
	document.querySelectorAll<HTMLButtonElement>('.videos .ctrl button').forEach((b) =>
		b.addEventListener('click', () => {
			const w = (rail.firstElementChild as HTMLElement).offsetWidth + 22;
			rail.scrollBy({ left: Number(b.dataset.d) * w, behavior: 'smooth' });
		})
	);
</script>
