---
const points = [
	'How IT professionals are moving to Cloud & DevOps in 2026',
	'DevOps Engineer Job 2026 | Real Work, Tools & Salary',
	'How your current Experience will help in Switching career',
	'Salary and Growth Opportunities',
];
---

<section class="section" id="section2">
	<div class="wrap">
		<div class="panel reveal">
			<div class="video">
				<video autoplay loop muted playsinline preload="none" data-src="/img/misc/demo.mp4" aria-label="Preview of MicroDegree's free Cloud and DevOps demo session"></video>
			</div>
			<div class="info">
				<h2>Take a Free Demo Today</h2>
				<p class="lead">In this Free Demo Session, you will learn:</p>
				<ul>
					{points.map((p) => <li><span class="tick">✓</span>{p}</li>)}
				</ul>
				<a class="btn btn-primary" href="/demopage">Take a Free Demo Now</a>
			</div>
		</div>
	</div>
</section>

<style>
	.panel {
		display: grid; grid-template-columns: 1fr 1fr; overflow: hidden; border-radius: 28px;
		background: #fff; border: 1px solid var(--line); box-shadow: var(--shadow);
	}
	.video { background: var(--brand-soft); display: grid; place-items: center; padding: 28px; }
	.video video { width: 100%; height: auto; border-radius: 16px; }
	.info { padding: 48px 44px; display: flex; flex-direction: column; justify-content: center; gap: 18px; align-items: flex-start; }
	h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 600; letter-spacing: -0.02em; }
	.lead { font-weight: 600; color: var(--muted); }
	ul { display: grid; gap: 14px; }
	li { display: flex; gap: 12px; align-items: flex-start; }
	.tick { flex: none; width: 24px; height: 24px; border-radius: 50%; background: var(--brand-soft); color: var(--brand); display: grid; place-items: center; font-size: .75rem; font-weight: 600; margin-top: 2px; }
	@media (max-width: 860px) {
		.panel { grid-template-columns: 1fr; }
		.info { padding: 28px 24px; }
		.btn { width: 100%; }
	}
</style>

<script>
	// Fetch the demo video only when it is about to scroll into view.
	const v = document.querySelector<HTMLVideoElement>('video[data-src]');
	if (v) {
		const io = new IntersectionObserver((e) => {
			if (e.some((x) => x.isIntersecting)) {
				v.src = v.dataset.src!;
				v.play().catch(() => {});
				io.disconnect();
			}
		}, { rootMargin: '800px 0px' });
		io.observe(v);
	}
</script>
