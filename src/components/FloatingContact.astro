---
// Floating WhatsApp + phone buttons (ported from MainWebsite-2026/public/index.html), with the same
// Clarity / Google Ads conversion / first-party tracking on click. Shown after scrolling:
// >350px on screens narrower than 1024px, >50px on desktop.
---

<a id="fixedWALink" class="md-float md-wa" aria-label="Chat with MicroDegree on WhatsApp"
	href="https://api.whatsapp.com/send?phone=918660238620&text=Hello%2C%20I%20have%20a%20question%20regarding%20Courses%2FCertification%2FOthers">
	<svg viewBox="0 0 448 512" width="30" height="30" fill="currentColor" aria-hidden="true"><path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7 .9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z" /></svg>
</a>

<a id="fixedPhoneLink" class="md-float md-ph" aria-label="Call MicroDegree" href="tel:+918047109999">
	<i class="fa-solid fa-phone" style="font-size:26px"></i>
</a>

<style is:global>
	.md-float {
		position: fixed; right: 30px; width: 60px; height: 60px; border-radius: 50px; color: #fff;
		display: none; align-items: center; justify-content: center; box-shadow: 2px 2px 3px #999; z-index: 100;
	}
	.md-float.show { display: flex; }
	.md-wa { bottom: 40px; background: #25d366; }
	.md-ph { bottom: 120px; background: #305ac6; }
</style>

<script>
	const wa = document.getElementById('fixedWALink') as HTMLAnchorElement;
	const ph = document.getElementById('fixedPhoneLink') as HTMLAnchorElement;
	const CONVERSION_WA = 'AW-625115666/x69-CKr8pqIcEJKEiqoC';
	const CONVERSION_PHONE = 'AW-625115666/MDe5CNmpk6EcEJKEiqoC';
	const PAGE_MESSAGES: Record<string, string> = {
		'/awsdevops': "Hello, I'm interested in the AWS & DevOps Certification Program and would like to know more.",
		'/genai': "Hello, I'm interested in the Generative AI & Agentic AI Certification Program and would like to know more.",
	};
	const DEFAULT_MESSAGE = 'Hello, I have a question regarding Courses/Certification/Others';
	const w = window as any;

	const waUrl = () => {
		const text = (PAGE_MESSAGES[location.pathname] || DEFAULT_MESSAGE) + `\n\n(Source: ${location.pathname})`;
		return 'https://api.whatsapp.com/send?phone=918660238620&text=' + encodeURIComponent(text);
	};
	wa.href = waUrl();

	// Ad landing pages use a different call-tracking number (same as the old site).
	if (['/cloud-devops-certification', '/tech-course', '/tech-courses', '/genaicourse'].includes(location.pathname.replace(/\/$/, ''))) {
		ph.href = 'tel:+918069484577';
	}

	// Show after scrolling (same thresholds as the old site).
	const toggle = () => {
		const show = window.scrollY > (window.innerWidth < 1024 ? 350 : 50);
		wa.classList.toggle('show', show);
		ph.classList.toggle('show', show);
	};
	window.addEventListener('scroll', toggle, { passive: true });
	toggle();

	// Fire the Google Ads conversion, then navigate (callback, with a 1s backup so the click never gets stuck).
	const convertThenGo = (sendTo: string, url: string) => {
		w.__mdLoadTags?.(); // make sure gtag.js is loading: a click can arrive before the deferred tags
		let done = false;
		const go = () => { if (!done) { done = true; window.location.href = url; } };
		if (typeof w.gtag === 'function') {
			w.gtag('event', 'conversion', { send_to: sendTo, value: 1.0, currency: 'INR', event_callback: go });
			setTimeout(go, 1000);
		} else go();
	};

	wa.addEventListener('click', (e) => {
		e.preventDefault();
		try { w.mdTrack?.('whatsapp_click', { element: 'floating_button' }); } catch { /* never block the redirect */ }
		if (typeof w.clarity === 'function') {
			w.clarity('set', 'wa_source', location.pathname);
			w.clarity('event', 'whatsapp_click');
		}
		convertThenGo(CONVERSION_WA, waUrl());
	});

	ph.addEventListener('click', (e) => {
		e.preventDefault();
		convertThenGo(CONVERSION_PHONE, ph.href);
	});

	import '../scripts/tracker';
</script>
