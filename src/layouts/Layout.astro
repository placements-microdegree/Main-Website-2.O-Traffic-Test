---
import '../styles/global.css';
import '../styles/icons.css';
import FloatingContact from '../components/FloatingContact.astro';

interface Props {
	title: string;
	description: string;
	canonical?: string;
	/** The home page preloads its hero image; other pages should not. */
	preloadHero?: boolean;
	robots?: string;
}
const { title, description, canonical = 'https://www.microdegree.work/', preloadHero = true, robots } = Astro.props;

const schema = {
	'@context': 'https://schema.org',
	'@type': 'EducationalOrganization',
	name: 'MicroDegree',
	url: 'https://www.microdegree.work/',
	contactPoint: {
		'@type': 'ContactPoint',
		telephone: '0804-710-9999',
		contactType: 'customer service',
		areaServed: 'IN',
		availableLanguage: ['en', 'Kannada'],
	},
	sameAs: [
		'https://www.facebook.com/microdegree',
		'https://x.com/micro_degree',
		'https://www.instagram.com/microdegree.work/',
		'https://www.youtube.com/microdegree',
		'https://www.linkedin.com/company/microdegree/',
	],
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="theme-color" content="#000000" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		{robots && <meta name="robots" content={robots} />}
		<slot name="head" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
			{preloadHero && <link rel="preload" as="image" href="/img/hero/ZDI-mobile.webp" media="(max-width: 767px)" fetchpriority="high" />}
			{preloadHero && <link rel="preload" as="image" href="/img/hero/ZDI.webp" media="(min-width: 768px)" fetchpriority="high" />}
			<link rel="preconnect" href="https://fonts.googleapis.com" />
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
			<!-- Non-blocking stylesheets: media=print swaps to all once loaded -->
			<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
			<noscript>
				<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
				</noscript>
		<script type="application/ld+json" set:html={JSON.stringify(schema)} />
		<!--
			Tracking (same IDs as MainWebsite-2026/public/index.html): GTM, GA4 x3, Google Ads, AdSense, Meta Pixel x2, Clarity x2.
			The queues/stubs are created immediately so no event is lost; the heavy third-party files are fetched after the
			page has loaded (or on first interaction), so they never compete with first paint.
		-->
		<script is:inline>
			(function () {
				var w = window, d = document;
				w.dataLayer = w.dataLayer || [];
				function gtag() { w.dataLayer.push(arguments); }
				w.gtag = gtag;
				gtag('js', new Date());
				['G-W10NN6S3KL', 'G-NXT05R9647', 'G-KF9TCK8HDL', 'AW-625115666'].forEach(function (id) { gtag('config', id); });

				var n = (w.fbq = function () { n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments); });
				if (!w._fbq) w._fbq = n;
				n.push = n; n.loaded = true; n.version = '2.0'; n.queue = [];
				w.fbq('init', '2260688611407524');
				w.fbq('init', '187849266414718');
				w.fbq('track', 'PageView');

				w.clarity = w.clarity || function () { (w.clarity.q = w.clarity.q || []).push(arguments); };

				function load(src, cors) {
					var s = d.createElement('script');
					s.async = true; s.src = src;
					if (cors) s.crossOrigin = 'anonymous';
					d.head.appendChild(s);
				}
				var started = false;
				function loadTags() {
					if (started) return;
					started = true;
					w.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
					load('https://www.googletagmanager.com/gtm.js?id=GTM-KD29V9Z');
					load('https://www.googletagmanager.com/gtag/js?id=G-W10NN6S3KL');
					load('https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-7261980403640770', true);
					load('https://connect.facebook.net/en_US/fbevents.js');
					load('https://www.clarity.ms/tag/77n7r6x6vd');
					load('https://www.clarity.ms/tag/wknm8tw9ry');
				}
				w.__mdLoadTags = loadTags;

				['pointerdown', 'keydown', 'scroll', 'touchstart'].forEach(function (ev) {
					w.addEventListener(ev, loadTags, { once: true, passive: true });
				});
				function afterLoad() { setTimeout(loadTags, 2500); }
				if (d.readyState === 'complete') afterLoad(); else w.addEventListener('load', afterLoad);
			})();
		</script>
	</head>
	<body>
		<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KD29V9Z" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
		<noscript><img height="1" width="1" style="display:none" alt="" src="https://www.facebook.com/tr?id=2260688611407524&ev=PageView&noscript=1" /><img height="1" width="1" style="display:none" alt="" src="https://www.facebook.com/tr?id=187849266414718&ev=PageView&noscript=1" /></noscript>
		<slot />
		<FloatingContact />
		<script>
			// Scroll-reveal for any element tagged .reveal
			const io = new IntersectionObserver(
				(entries) => {
					for (const e of entries) {
						if (e.isIntersecting) {
							e.target.classList.add('in');
							io.unobserve(e.target);
						}
					}
				},
				{ threshold: 0.12 }
			);
			document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
		</script>
	</body>
</html>
